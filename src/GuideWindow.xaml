<Window x:Class="RenoDXLauncher.GuideWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Guia HDR" Height="740" Width="660" MinWidth="520"
        Background="{StaticResource BgBrush}" WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <Style x:Key="StepNum" TargetType="Border">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Background" Value="#2A1F12"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
        </Style>
        <Style x:Key="StepBody" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="LineHeight" Value="19"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Foreground" Value="{StaticResource TextDimBrush}"/>
            <Setter Property="Margin" Value="0,3,0,0"/>
        </Style>
    </Window.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{StaticResource PanelBrush}" Padding="24,18"
                BorderBrush="{StaticResource BorderBrush2}" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal">
                <Border Width="38" Height="38" CornerRadius="10" Background="#2A1F12">
                    <Path Data="{StaticResource IconBook}" Fill="{StaticResource AccentBrush}"
                          Stretch="Uniform" Width="20" Height="20"/>
                </Border>
                <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Checklist HDR" Style="{StaticResource H1}"/>
                    <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,0"
                               Text="Faça isso uma vez e todos os jogos ficam certos."/>
                </StackPanel>
            </StackPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,20,18,24">
            <StackPanel>
                <!-- 1 -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                    <Border Style="{StaticResource StepNum}">
                        <TextBlock Text="1" FontWeight="Bold" FontSize="12" Foreground="{StaticResource AccentBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="14,0,0,0" MaxWidth="520">
                        <TextBlock Text="Ligue o HDR do Windows ANTES de abrir o jogo" Style="{StaticResource H2}"/>
                        <TextBlock Style="{StaticResource StepBody}"
                                   Text="Atalho: Win + Alt + B. A troca automática não funciona com alguns mods."/>
                    </StackPanel>
                </StackPanel>
                <!-- 2 -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                    <Border Style="{StaticResource StepNum}">
                        <TextBlock Text="2" FontWeight="Bold" FontSize="12" Foreground="{StaticResource AccentBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="14,0,0,0" MaxWidth="520">
                        <TextBlock Text="Desligue AutoHDR e RTX HDR" Style="{StaticResource H2}"/>
                        <TextBlock Style="{StaticResource StepBody}"
                                   Text="Imagem lavada ou estourada é tonemapping duplo. AutoHDR: Configurações → Sistema → Vídeo → HDR. RTX HDR: NVIDIA App → Graphics."/>
                    </StackPanel>
                </StackPanel>
                <!-- 3 -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                    <Border Style="{StaticResource StepNum}">
                        <TextBlock Text="3" FontWeight="Bold" FontSize="12" Foreground="{StaticResource AccentBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="14,0,0,0" MaxWidth="520">
                        <TextBlock Text="Rode o app “Calibração de HDR do Windows” uma vez" Style="{StaticResource H2}"/>
                        <TextBlock Style="{StaticResource StepBody}"
                                   Text="O ponto onde o padrão desaparece é o brilho máximo real do seu monitor — use esse número em “Meu monitor”. Em TVs: modo HGIG ligado e Dynamic Tone Mapping desligado."/>
                    </StackPanel>
                </StackPanel>
                <!-- 4 -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                    <Border Style="{StaticResource StepNum}">
                        <TextBlock Text="4" FontWeight="Bold" FontSize="12" Foreground="{StaticResource AccentBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="14,0,0,0" MaxWidth="520">
                        <TextBlock Text="Valores recomendados" Style="{StaticResource H2}"/>
                        <TextBlock Style="{StaticResource StepBody}"
                                   Text="Brilho máximo: o valor real do monitor (OLED ~800–1000, miniLED 1000–1500).&#10;Brilho do jogo (paper white): 203 nits; 100–300 conforme a luz do ambiente.&#10;Brilho da interface: 203, igual ao do jogo.&#10;Tone mapper e gamma: deixe no padrão do mod — foi calibrado por jogo."/>
                    </StackPanel>
                </StackPanel>
                <!-- 5 -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                    <Border Style="{StaticResource StepNum}">
                        <TextBlock Text="5" FontWeight="Bold" FontSize="12" Foreground="{StaticResource AccentBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="14,0,0,0" MaxWidth="520">
                        <TextBlock Text="Dentro do jogo" Style="{StaticResource H2}"/>
                        <TextBlock Style="{StaticResource StepBody}"
                                   Text="O overlay do ReShade abre com a tecla Home; o RenoDX fica na aba Add-ons. Se editar aqui no launcher com o jogo aberto, mova o slider “Preset” para 2 e volte para 1 no overlay para recarregar."/>
                    </StackPanel>
                </StackPanel>

                <!-- anti-cheat -->
                <Border Background="#3A1E1E" BorderBrush="#6E3232" BorderThickness="1" CornerRadius="10"
                        Padding="14,12" Margin="0,4,0,12">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconBlock}" Fill="#FF9E9E" Stretch="Uniform"
                              Width="18" Height="18" VerticalAlignment="Top" Margin="0,2,0,0"/>
                        <StackPanel Margin="12,0,0,0" MaxWidth="520">
                            <TextBlock Text="Anti-cheat (jogos online)" Style="{StaticResource H2}" Foreground="#FFC9C9"/>
                            <TextBlock Style="{StaticResource StepBody}" Foreground="#F0B5B5"
                                       Text="O ReShade com suporte a add-ons é uma build NÃO assinada. Em jogos com EAC/BattlEye (Elden Ring, GTA Online...) pode dar banimento. Jogue offline nesses casos — o launcher detecta e avisa antes de instalar."/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- conflitos -->
                <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush2}"
                        BorderThickness="1" CornerRadius="10" Padding="14,12">
                    <StackPanel>
                        <TextBlock Text="Conflitos conhecidos" Style="{StaticResource H2}"/>
                        <TextBlock Style="{StaticResource StepBody}"
                                   Text="Special K não é suportado junto com RenoDX.&#10;Outro dxgi.dll na pasta (ENB, dxvk...): o launcher detecta e não sobrescreve.&#10;Mods genéricos (Unreal/Unity): evite fullscreen exclusivo; ajustes de “Upgrade” podem exigir reiniciar o jogo."/>
                    </StackPanel>
                </Border>

                <TextBlock Style="{StaticResource Caption}" Margin="0,18,0,0" FontSize="11"
                           Foreground="{StaticResource TextFaintBrush}"
                           Text="Fontes: wiki do RenoDX · hdrmods.com · dados por jogo do projeto RHI (GPL-3.0) · ITU-R BT.2408."/>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
