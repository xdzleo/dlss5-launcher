<Window x:Class="RenoDXLauncher.GuideWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:RenoDXLauncher.Localization"
        Title="{loc:Tr Guide_Window_Title}" Height="740" Width="660" MinWidth="520"
        Background="{StaticResource BgBrush}" WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <Style x:Key="StepNum" TargetType="Border">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Background" Value="#2A1F12"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
        </Style>
        <Style x:Key="StepBody" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="LineHeight" Value="19"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Foreground" Value="{StaticResource TextDimBrush}"/>
            <Setter Property="Margin" Value="0,3,0,0"/>
        </Style>
    </Window.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{StaticResource PanelBrush}" Padding="24,18"
                BorderBrush="{StaticResource BorderBrush2}" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal">
                <Border Width="38" Height="38" CornerRadius="10" Background="#2A1F12">
                    <Path Data="{StaticResource IconBook}" Stroke="{StaticResource AccentBrush}" StrokeThickness="2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Stretch="Uniform" Width="20" Height="20"/>
                </Border>
                <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{loc:Tr Guide_Header_Title}" Style="{StaticResource H1}"/>
                    <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,0"
                               Text="{loc:Tr Guide_Header_Subtitle}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,20,18,24">
            <StackPanel>
                <!-- 1 -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                    <Border Style="{StaticResource StepNum}">
                        <TextBlock Text="1" FontWeight="Bold" FontSize="12" Foreground="{StaticResource AccentBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="14,0,0,0" MaxWidth="520">
                        <TextBlock Text="{loc:Tr Guide_Step1_Title}" Style="{StaticResource H2}"/>
                        <TextBlock Style="{StaticResource StepBody}"
                                   Text="{loc:Tr Guide_Step1_Body}"/>
                    </StackPanel>
                </StackPanel>
                <!-- 2 -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                    <Border Style="{StaticResource StepNum}">
                        <TextBlock Text="2" FontWeight="Bold" FontSize="12" Foreground="{StaticResource AccentBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="14,0,0,0" MaxWidth="520">
                        <TextBlock Text="{loc:Tr Guide_Step2_Title}" Style="{StaticResource H2}"/>
                        <TextBlock Style="{StaticResource StepBody}"
                                   Text="{loc:Tr Guide_Step2_Body}"/>
                    </StackPanel>
                </StackPanel>
                <!-- 3 -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                    <Border Style="{StaticResource StepNum}">
                        <TextBlock Text="3" FontWeight="Bold" FontSize="12" Foreground="{StaticResource AccentBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="14,0,0,0" MaxWidth="520">
                        <TextBlock Text="{loc:Tr Guide_Step3_Title}" Style="{StaticResource H2}"/>
                        <TextBlock Style="{StaticResource StepBody}"
                                   Text="{loc:Tr Guide_Step3_Body}"/>
                    </StackPanel>
                </StackPanel>
                <!-- 4 -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                    <Border Style="{StaticResource StepNum}">
                        <TextBlock Text="4" FontWeight="Bold" FontSize="12" Foreground="{StaticResource AccentBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="14,0,0,0" MaxWidth="520">
                        <TextBlock Text="{loc:Tr Guide_Step4_Title}" Style="{StaticResource H2}"/>
                        <TextBlock Style="{StaticResource StepBody}"
                                   Text="{loc:Tr Guide_Step4_Body}"/>
                    </StackPanel>
                </StackPanel>
                <!-- 5 -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                    <Border Style="{StaticResource StepNum}">
                        <TextBlock Text="5" FontWeight="Bold" FontSize="12" Foreground="{StaticResource AccentBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="14,0,0,0" MaxWidth="520">
                        <TextBlock Text="{loc:Tr Guide_Step5_Title}" Style="{StaticResource H2}"/>
                        <TextBlock Style="{StaticResource StepBody}"
                                   Text="{loc:Tr Guide_Step5_Body}"/>
                    </StackPanel>
                </StackPanel>

                <!-- anti-cheat -->
                <Border Background="#3A1E1E" BorderBrush="#6E3232" BorderThickness="1" CornerRadius="10"
                        Padding="14,12" Margin="0,4,0,12">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconBlock}" Stroke="#FF9E9E" StrokeThickness="2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stretch="Uniform"
                              Width="18" Height="18" VerticalAlignment="Top" Margin="0,2,0,0"/>
                        <StackPanel Margin="12,0,0,0" MaxWidth="520">
                            <TextBlock Text="{loc:Tr Guide_AntiCheat_Title}" Style="{StaticResource H2}" Foreground="#FFC9C9"/>
                            <TextBlock Style="{StaticResource StepBody}" Foreground="#F0B5B5"
                                       Text="{loc:Tr Guide_AntiCheat_Body}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- conflitos -->
                <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush2}"
                        BorderThickness="1" CornerRadius="10" Padding="14,12">
                    <StackPanel>
                        <TextBlock Text="{loc:Tr Guide_Conflicts_Title}" Style="{StaticResource H2}"/>
                        <TextBlock Style="{StaticResource StepBody}"
                                   Text="{loc:Tr Guide_Conflicts_Body}"/>
                    </StackPanel>
                </Border>

                <TextBlock Style="{StaticResource Caption}" Margin="0,18,0,0" FontSize="11"
                           Foreground="{StaticResource TextFaintBrush}"
                           Text="{loc:Tr Guide_Sources}"/>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
