<Window x:Class="RenoDXLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:RenoDXLauncher.ViewModels"
        xmlns:local="clr-namespace:RenoDXLauncher"
        Title="RenoDX Launcher" Height="860" Width="1420"
        Background="{StaticResource BgBrush}"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <local:CoverImageConverter x:Key="CoverImage"/>
        <!-- game tile -->
        <DataTemplate x:Key="GameTile" DataType="{x:Type vm:GameItemVm}">
            <Border Width="168" Margin="8" Background="{StaticResource CardBrush}"
                    CornerRadius="8" BorderThickness="1" BorderBrush="{StaticResource BorderBrush2}">
                <StackPanel>
                    <Grid Height="238">
                        <Border CornerRadius="8,8,0,0" Background="#1B1B20">
                            <TextBlock Text="{Binding Initials}" FontSize="44" FontWeight="Bold"
                                       Foreground="{StaticResource GrayBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <Border CornerRadius="8,8,0,0"
                                Visibility="{Binding HasCover, Converter={StaticResource BoolToVis}}">
                            <Border.Background>
                                <ImageBrush ImageSource="{Binding CoverPath, Converter={StaticResource CoverImage}}"
                                            Stretch="UniformToFill"/>
                            </Border.Background>
                        </Border>
                        <Border VerticalAlignment="Top" HorizontalAlignment="Right" Margin="6"
                                CornerRadius="4" Padding="6,2" Background="#CC17171B">
                            <TextBlock Text="{Binding StoreLabel}" FontSize="10" Foreground="{StaticResource TextDimBrush}"/>
                        </Border>
                    </Grid>
                    <TextBlock Text="{Binding Name}" Margin="8,6,8,2" FontSize="12" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
                    <Border Margin="8,2,8,8" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{StaticResource GrayBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Badge}" Value="Enabled">
                                        <Setter Property="Background" Value="{StaticResource GreenBrush}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Badge}" Value="Disabled">
                                        <Setter Property="Background" Value="{StaticResource OrangeBrush}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Badge}" Value="Available">
                                        <Setter Property="Background" Value="{StaticResource BlueBrush}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Badge}" Value="NexusOnly">
                                        <Setter Property="Background" Value="#7A6A9E"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding BadgeText}" FontSize="10" FontWeight="Bold" Foreground="#101014"/>
                    </Border>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- one setting row -->
        <DataTemplate x:Key="SettingRow" DataType="{x:Type vm:SettingVm}">
            <Border Margin="0,3" Padding="10,8" CornerRadius="6" Background="{StaticResource CardBrush}"
                    ToolTip="{Binding Tooltip}" ToolTipService.ShowDuration="30000">
                <StackPanel>
                    <DockPanel>
                        <TextBlock Text="{Binding ValueText}" DockPanel.Dock="Right" FontWeight="Bold"
                                   Foreground="{StaticResource AccentBrush}"
                                   Visibility="{Binding IsSlider, Converter={StaticResource BoolToVis}}"/>
                        <TextBlock Text="{Binding Label}" FontSize="12"/>
                    </DockPanel>
                    <Slider Minimum="{Binding Min}" Maximum="{Binding Max}"
                            Value="{Binding Value, Mode=TwoWay}"
                            TickFrequency="{Binding Step}" IsSnapToTickEnabled="True" Margin="0,4,0,0"
                            Visibility="{Binding IsSlider, Converter={StaticResource BoolToVis}}"/>
                    <ComboBox ItemsSource="{Binding ComboLabels}" SelectedIndex="{Binding ComboIndex, Mode=TwoWay}"
                              Margin="0,4,0,0"
                              Visibility="{Binding IsCombo, Converter={StaticResource BoolToVis}}"/>
                    <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" Content="Ativo" Margin="0,4,0,0"
                              Visibility="{Binding IsCheck, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <DockPanel>
        <!-- top bar -->
        <Border DockPanel.Dock="Top" Background="{StaticResource PanelBrush}" Padding="14,10">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <TextBlock Text="RenoDX" FontSize="20" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                    <TextBlock Text=" Launcher" FontSize="20" FontWeight="Light"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                    <TextBox x:Name="SearchBox" Width="240" Margin="0,0,8,0" VerticalContentAlignment="Center"
                             Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Pesquisar jogo"/>
                    <ComboBox Width="170" Margin="0,0,8,0" VerticalContentAlignment="Center"
                              ItemsSource="{Binding FilterOptions}" SelectedIndex="{Binding FilterIndex}"/>
                    <Button Content="🔄 Atualizar" Margin="0,0,8,0" Command="{Binding RefreshCommand}"/>
                    <Button Content="➕ Adicionar jogo" Margin="0,0,8,0" Command="{Binding AddManualGameCommand}"/>
                    <Button Content="🖥️ Meu monitor" Margin="0,0,8,0" Click="OnProfileClick"/>
                    <Button Content="📖 Guia HDR" Click="OnGuideClick"/>
                </StackPanel>
                <Border/>
            </DockPanel>
        </Border>

        <!-- status bar -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource PanelBrush}" Padding="14,6">
            <DockPanel>
                <ProgressBar DockPanel.Dock="Right" Width="120" Height="10" IsIndeterminate="True"
                             Visibility="{Binding Busy, Converter={StaticResource BoolToVis}}"/>
                <TextBlock Text="{Binding StatusText}" FontSize="11" Foreground="{StaticResource TextDimBrush}"/>
            </DockPanel>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- game grid -->
            <ListBox Grid.Column="0" ItemsSource="{Binding GamesView}" SelectedItem="{Binding Selected}"
                     Background="Transparent" BorderThickness="0" Margin="8"
                     ItemTemplate="{StaticResource GameTile}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     VirtualizingPanel.IsVirtualizing="False">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Bd" CornerRadius="10" BorderThickness="2" BorderBrush="Transparent">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#22FFFFFF"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>

            <!-- detail panel -->
            <Border Grid.Column="1" Width="420" Background="{StaticResource PanelBrush}"
                    Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14">
                    <StackPanel>
                        <TextBlock Text="{Binding Selected.Name}" FontSize="18" FontWeight="Bold" TextWrapping="Wrap"/>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBlock Text="{Binding Selected.StoreLabel}" Foreground="{StaticResource TextDimBrush}" FontSize="11"/>
                            <TextBlock Text="  •  " Foreground="{StaticResource TextDimBrush}" FontSize="11"/>
                            <TextBlock Text="{Binding Selected.BadgeText}" FontSize="11" FontWeight="Bold"
                                       Foreground="{StaticResource AccentBrush}"/>
                        </StackPanel>
                        <TextBlock Text="{Binding Selected.Mod.Maintainer, StringFormat='Mod por: {0}'}"
                                   FontSize="11" Foreground="{StaticResource TextDimBrush}" Margin="0,2,0,0"
                                   Visibility="{Binding Selected.HasMod, Converter={StaticResource BoolToVis}}"/>

                        <!-- exe picker -->
                        <TextBlock Text="Executável do jogo (onde o mod é instalado):" FontSize="11"
                                   Margin="0,12,0,4" Foreground="{StaticResource TextDimBrush}"/>
                        <ComboBox ItemsSource="{Binding ExeCandidates}" SelectedItem="{Binding SelectedExe}"
                                  FontSize="11"/>

                        <!-- actions -->
                        <UniformGrid Columns="2" Margin="0,12,0,0">
                            <Button Style="{StaticResource AccentButton}" Margin="0,0,4,4"
                                    Command="{Binding InstallCommand}">
                                <TextBlock Text="⬇ Instalar / Atualizar mod" FontSize="12"/>
                            </Button>
                            <Button Margin="4,0,0,4" Command="{Binding ToggleCommand}">
                                <TextBlock FontSize="12">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="⏻ Ativar"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Selected.IsEnabled}" Value="True">
                                                    <Setter Property="Text" Value="⏻ Desativar"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Button>
                            <Button Margin="0,0,4,0" Command="{Binding RemoveCommand}">
                                <TextBlock Text="🗑 Remover" FontSize="12"/>
                            </Button>
                            <Button Margin="4,0,0,0" Command="{Binding OpenFolderCommand}">
                                <TextBlock Text="📂 Abrir pasta" FontSize="12"/>
                            </Button>
                        </UniformGrid>
                        <Button Margin="0,8,0,0" Command="{Binding OpenNexusCommand}"
                                Visibility="{Binding Selected.HasMod, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="🌐 Página no Nexus Mods" FontSize="12"/>
                        </Button>

                        <TextBlock Text="{Binding DetailStatus}" TextWrapping="Wrap" Margin="0,10,0,0"
                                   FontSize="11" Foreground="{StaticResource OrangeBrush}"/>

                        <!-- notes -->
                        <ItemsControl ItemsSource="{Binding Notes}" Margin="0,10,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#2A2418" BorderBrush="#5E4A1E" BorderThickness="1"
                                            CornerRadius="6" Padding="8" Margin="0,3">
                                        <TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="11"
                                                   Foreground="#E8D9A8"/>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- settings -->
                        <StackPanel Visibility="{Binding Selected.IsInstalled, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="Configurações do mod" FontSize="15" FontWeight="Bold" Margin="0,16,0,2"/>
                            <TextBlock FontSize="11" Foreground="{StaticResource TextDimBrush}" TextWrapping="Wrap"
                                       Text="Editadas direto no ReShade.ini do jogo ([renodx-preset1]). Salve com o jogo FECHADO."/>
                            <ItemsControl x:Name="SettingsList" ItemsSource="{Binding Settings}"
                                          ItemTemplate="{StaticResource SettingRow}" Margin="0,8,0,0"/>
                            <UniformGrid Columns="3" Margin="0,10,0,0">
                                <Button Style="{StaticResource AccentButton}" Margin="0,0,4,0"
                                        Command="{Binding SaveSettingsCommand}">
                                    <TextBlock Text="💾 Salvar" FontSize="12"/>
                                </Button>
                                <Button Margin="2,0,2,0" Command="{Binding ApplyProfileCommand}"
                                        ToolTip="Escreve os nits do seu monitor (botão 'Meu monitor' na barra superior) neste jogo.">
                                    <TextBlock Text="🖥️ Usar meu perfil" FontSize="12"/>
                                </Button>
                                <Button Margin="4,0,0,0" Command="{Binding ResetSettingsCommand}">
                                    <TextBlock Text="↩ Padrão" FontSize="12"/>
                                </Button>
                            </UniformGrid>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </DockPanel>
</Window>
