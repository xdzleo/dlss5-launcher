<Window x:Class="RenoDXLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:RenoDXLauncher.ViewModels"
        xmlns:local="clr-namespace:RenoDXLauncher"
        xmlns:loc="clr-namespace:RenoDXLauncher.Localization"
        Icon="Assets/app.png"
        Title="{loc:Tr App_Name}" Height="920" Width="1560" MinWidth="1240" MinHeight="660"
        Background="{StaticResource BgBrush}"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <local:CoverImageConverter x:Key="CoverImage"/>
        <local:AdviceColorConverter x:Key="AdviceBg"/>
        <local:AdviceColorConverter x:Key="AdviceFg" Foreground="True"/>
        <local:CountToVisConverter x:Key="CountToVis"/>
        <local:StoreIconConverter x:Key="StoreIcon"/>
        <local:InverseBoolToVisConverter x:Key="NotToVis"/>
        <local:TextToVisConverter x:Key="TextToVis"/>
        <local:NoteColorConverter x:Key="NoteBg"/>
        <local:NoteColorConverter x:Key="NoteBorder" Border="True"/>
        <local:NivelColorConverter x:Key="NivelToBrush"/>
        <local:NivelTextConverter x:Key="NivelToText"/>

        <!-- ===== one piece of guidance: where to do it, who said it, and the exact text ===== -->
        <DataTemplate x:Key="NoteCard">
            <Border Background="{Binding Kind, Converter={StaticResource NoteBg}}"
                    BorderBrush="{Binding Kind, Converter={StaticResource NoteBorder}}"
                    BorderThickness="1" CornerRadius="9" Padding="12,10" Margin="0,0,0,7">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                        <!-- WHERE the user has to act: an instruction that does not say whether it
                             happens in the game or in the overlay is half an instruction -->
                        <Border CornerRadius="4" Padding="6,2" Margin="0,0,7,0" Background="#22000000"
                                Visibility="{Binding Location, Converter={StaticResource TextToVis}}">
                            <TextBlock Text="{Binding Location}" FontSize="9.5" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextBrush}"/>
                        </Border>
                        <TextBlock Text="{Binding Title}" FontSize="11.5" FontWeight="SemiBold"
                                   VerticalAlignment="Center" Foreground="{StaticResource TextBrush}"
                                   Visibility="{Binding Title, Converter={StaticResource TextToVis}}"/>
                    </StackPanel>
                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="12" LineHeight="18"
                               Foreground="{StaticResource TextBrush}"
                               Visibility="{Binding Text, Converter={StaticResource TextToVis}}"/>
                    <!-- Verbatim block (ini snippet, launch argument): monospaced and selectable.
                         No inner ScrollViewer — a nested one swallows the mouse wheel and the
                         whole modal stops scrolling while the cursor is over the block. Wrapping
                         instead of clipping, so nothing is lost off the right edge. -->
                    <Border CornerRadius="6" Padding="9,7" Margin="0,7,0,0" Background="#1A1D24"
                            BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1"
                            Visibility="{Binding Preformatted, Converter={StaticResource TextToVis}}">
                        <TextBox Text="{Binding Preformatted, Mode=OneWay}" IsReadOnly="True"
                                 FontFamily="Consolas" FontSize="11" Background="Transparent"
                                 BorderThickness="0" Foreground="#C9D4E4" TextWrapping="Wrap"
                                 HorizontalScrollBarVisibility="Disabled"
                                 VerticalScrollBarVisibility="Disabled"
                                 Padding="0" ToolTip="{loc:Tr Common_SelectToCopy}"/>
                    </Border>
                    <ItemsControl ItemsSource="{Binding Links}" Margin="0,7,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Margin="0,2,0,0" FontSize="11.5">
                                    <Hyperlink NavigateUri="{Binding Url}"
                                               RequestNavigate="OnNoteLinkNavigate"
                                               Foreground="{StaticResource AccentBrush}"
                                               ToolTip="{Binding Url}">
                                        <TextBlock Text="{Binding Label}"/>
                                    </Hyperlink>
                                </TextBlock>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- ===== game tile: cover fills the card, text sits on a scrim ===== -->
        <DataTemplate x:Key="GameTile" DataType="{x:Type vm:GameItemVm}">
            <Grid x:Name="Root" Width="184" Height="286" Margin="9">
                <Border x:Name="Card" CornerRadius="12" Background="{StaticResource CardBrush}"
                        BorderThickness="1" BorderBrush="{StaticResource BorderBrush2}"
                        RenderTransformOrigin="0.5,0.5" ClipToBounds="True">
                    <Border.RenderTransform>
                        <ScaleTransform x:Name="CardScale" ScaleX="1" ScaleY="1"/>
                    </Border.RenderTransform>
                    <Grid>
                        <!-- fallback: initials -->
                        <TextBlock Text="{Binding Initials}" FontSize="44" FontWeight="Bold"
                                   Foreground="#3A414E" HorizontalAlignment="Center"
                                   VerticalAlignment="Center" Margin="0,0,0,40"/>
                        <!-- cover. CornerRadius aqui tambem: o Border de fora arredonda so o que ELE
                             pinta (fundo e borda) e nao recorta os filhos, entao a capa saia quadrada
                             por cima dos quatro cantos arredondados do card. Raio 11 = 12 da moldura
                             menos 1 px de borda, para os dois arcos ficarem concentricos. -->
                        <Border CornerRadius="11"
                                Visibility="{Binding HasCover, Converter={StaticResource BoolToVis}}">
                            <Border.Background>
                                <ImageBrush ImageSource="{Binding CoverPath, Converter={StaticResource CoverImage}}"
                                            Stretch="UniformToFill"/>
                            </Border.Background>
                        </Border>
                        <!-- scrim so the title is always legible over any art -->
                        <Border VerticalAlignment="Bottom" Height="128" CornerRadius="0,0,11,11">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#00101216" Offset="0"/>
                                    <GradientStop Color="#C8101216" Offset="0.45"/>
                                    <GradientStop Color="#F5101216" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>

                        <!-- store mark -->
                        <Border VerticalAlignment="Top" HorizontalAlignment="Left" Margin="9"
                                CornerRadius="7" Width="27" Height="27" Background="#B3080A0E"
                                ToolTip="{Binding StoreLabel}">
                            <Path Data="{Binding Game.Store, Converter={StaticResource StoreIcon}}"
                                  Fill="#E8EDF5" Stretch="Uniform" Width="14" Height="14"/>
                        </Border>

                        <!-- update flag: the loudest thing on the tile -->
                        <Border VerticalAlignment="Top" HorizontalAlignment="Right" Margin="9"
                                CornerRadius="7" Padding="7,4" Background="#E6A11B"
                                Visibility="{Binding HasUpdate, Converter={StaticResource BoolToVis}}"
                                ToolTip="{loc:Tr Main_Tile_Update_Tooltip}">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconWarning}" Fill="#231A05" Stretch="Uniform"
                                      Width="11" Height="11" VerticalAlignment="Center"/>
                                <TextBlock Text="{loc:Tr Main_Tile_UpdateBadge}" FontSize="9" FontWeight="Bold" Margin="4,0,0,0"
                                           Foreground="#231A05" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- title + status -->
                        <StackPanel VerticalAlignment="Bottom" Margin="12,0,12,12">
                            <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold"
                                       Foreground="White" TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding Name}" MaxHeight="34" TextWrapping="Wrap"/>
                            <!-- Os dois recursos, lado a lado.
                                 Um selo unico dizia "ENABLED" sem dizer ENABLED O QUE: sao duas
                                 coisas independentes, e um jogo pode ter DLSS 5 rodando com o mod
                                 HDR desligado, ou o contrario.
                                 Cinza nao e "desligado", e "nao existe para este jogo" — vermelho
                                 convida a clicar, cinza avisa que nao ha o que clicar. -->
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <Ellipse Width="7" Height="7" VerticalAlignment="Center">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="{StaticResource RedBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding LuzDlss5}" Value="Verde">
                                                    <Setter Property="Fill" Value="{StaticResource GreenBrush}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding LuzDlss5}" Value="Cinza">
                                                    <Setter Property="Fill" Value="#5A6272"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Text="DLSS 5" FontSize="9.5" FontWeight="SemiBold"
                                           Margin="5,0,0,0" VerticalAlignment="Center"
                                           Foreground="#96A0B2"/>

                                <Ellipse Width="7" Height="7" VerticalAlignment="Center" Margin="12,0,0,0">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="{StaticResource RedBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding LuzHdr}" Value="Verde">
                                                    <Setter Property="Fill" Value="{StaticResource GreenBrush}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding LuzHdr}" Value="Cinza">
                                                    <Setter Property="Fill" Value="#3E4553"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Text="RenoDX HDR" FontSize="9.5" FontWeight="SemiBold"
                                           Margin="5,0,0,0" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#96A0B2"/>
                                            <Style.Triggers>
                                                <!-- indisponivel: o rotulo apaga junto com a bolinha,
                                                     senao parece um interruptor esperando clique -->
                                                <DataTrigger Binding="{Binding LuzHdr}" Value="Cinza">
                                                    <Setter Property="Foreground" Value="#5A6272"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
            <DataTemplate.Triggers>
                <Trigger SourceName="Card" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Card" Property="BorderBrush" Value="#5A6478"/>
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="CardScale" Storyboard.TargetProperty="ScaleX"
                                                 To="1.035" Duration="0:0:0.14"/>
                                <DoubleAnimation Storyboard.TargetName="CardScale" Storyboard.TargetProperty="ScaleY"
                                                 To="1.035" Duration="0:0:0.14"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="CardScale" Storyboard.TargetProperty="ScaleX"
                                                 To="1" Duration="0:0:0.14"/>
                                <DoubleAnimation Storyboard.TargetName="CardScale" Storyboard.TargetProperty="ScaleY"
                                                 To="1" Duration="0:0:0.14"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.ExitActions>
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- ===== setting row ===== -->
        <DataTemplate x:Key="SettingRow" DataType="{x:Type vm:SettingVm}">
            <Border Width="248" Margin="0,0,8,8" Padding="13,11" CornerRadius="9" Background="{StaticResource CardBrush}"
                    BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1"
                    ToolTip="{Binding Tooltip}" ToolTipService.ShowDuration="40000"
                    ToolTipService.InitialShowDelay="350">
                <StackPanel>
                    <DockPanel>
                        <Border DockPanel.Dock="Right" CornerRadius="6" Padding="8,3" Background="#2A3040"
                                Visibility="{Binding IsSlider, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding ValueText}" FontWeight="SemiBold" FontSize="11.5"
                                       Foreground="{StaticResource AccentBrush}"/>
                        </Border>
                        <TextBlock Text="{Binding Label}" FontSize="12.5" VerticalAlignment="Center"/>
                    </DockPanel>
                    <Slider Minimum="{Binding Min}" Maximum="{Binding Max}"
                            Value="{Binding Value, Mode=TwoWay}"
                            TickFrequency="{Binding Step}" IsSnapToTickEnabled="True" Margin="0,8,0,0"
                            Visibility="{Binding IsSlider, Converter={StaticResource BoolToVis}}"/>
                    <ComboBox ItemsSource="{Binding ComboLabels}" SelectedIndex="{Binding ComboIndex, Mode=TwoWay}"
                              Margin="0,8,0,0"
                              Visibility="{Binding IsCombo, Converter={StaticResource BoolToVis}}"/>
                    <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" Content="{loc:Tr Common_Enabled}" Margin="0,8,0,0"
                              Visibility="{Binding IsCheck, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid>
    <DockPanel>
        <!-- ===== top bar ===== -->
        <Border DockPanel.Dock="Top" Padding="20,13"
                BorderBrush="{StaticResource BorderBrush2}" BorderThickness="0,0,0,1">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#191C22" Offset="0"/>
                    <GradientStop Color="#15171C" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <!-- Mesma identidade do icone: fundo escuro, o "5" em verde-lima -> ciano.
                         O laranja com "R" era do RenoDX, que e uma das coisas que o launcher
                         instala, nao o que ele e. -->
                    <Border Width="30" Height="30" CornerRadius="8" Margin="0,0,11,0"
                            Background="#0E1116" BorderBrush="#2A3340" BorderThickness="1">
                        <TextBlock Text="5" FontSize="18" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock.Foreground>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#BEFF78" Offset="0"/>
                                    <GradientStop Color="#3CD2FF" Offset="1"/>
                                </LinearGradientBrush>
                            </TextBlock.Foreground>
                        </TextBlock>
                    </Border>
                    <TextBlock Text="DLSS 5" FontSize="19" FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBlock Text="Launcher" FontSize="19" FontWeight="Light" Margin="7,0,0,0"
                               Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <Grid Width="234" Margin="0,0,10,0">
                        <TextBox x:Name="SearchBox" VerticalContentAlignment="Center" Padding="33,7,9,7"
                                 Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}"/>
                        <Path Data="{StaticResource IconSearch}" Fill="{StaticResource TextFaintBrush}"
                              Stretch="Uniform" Width="14" Height="14" HorizontalAlignment="Left"
                              VerticalAlignment="Center" Margin="12,0,0,0" IsHitTestVisible="False"/>
                        <TextBlock Text="{loc:Tr Main_SearchPlaceholder}" Foreground="{StaticResource TextFaintBrush}"
                                   FontSize="12.5" VerticalAlignment="Center" Margin="34,0,0,0"
                                   IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>

                    <ComboBox Width="168" Margin="0,0,16,0" VerticalContentAlignment="Center"
                              ItemsSource="{Binding FilterOptions}" SelectedIndex="{Binding FilterIndex}"/>

                    <!-- update-all: loud when there is something to update -->
                    <Button Margin="0,0,10,0" AutomationProperties.Name="{loc:Tr Main_UpdateAll_Name}" Command="{Binding UpdateAllCommand}" Padding="13,8"
                            Visibility="{Binding HasUpdates, Converter={StaticResource BoolToVis}}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource AccentButton}">
                                <Setter Property="Background" Value="#E6A11B"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#F5B534"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconWarning}" Fill="#231A05" Stretch="Uniform"
                                  Width="14" Height="14" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding UpdateAllText}" Margin="7,0,0,0" VerticalAlignment="Center"
                                       Foreground="#231A05" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource ToolButton}" Margin="0,0,7,0" AutomationProperties.Name="{loc:Tr Main_Refresh_Name}" Command="{Binding RefreshCommand}">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource IconPath}" Data="{StaticResource IconRefresh}"/>
                            <TextBlock Text="{loc:Tr Common_Refresh}" Margin="7,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ToolButton}" Margin="0,0,7,0" AutomationProperties.Name="{loc:Tr Main_CheckUpdates}" Command="{Binding CheckUpdatesCommand}">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource IconPath}" Data="{StaticResource IconUpdate}"/>
                            <TextBlock Text="{loc:Tr Main_CheckUpdates}" Margin="7,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ToolButton}" Margin="0,0,7,0"
                            AutomationProperties.Name="{loc:Tr Main_AddGame_Name}" Command="{Binding AddManualGameCommand}">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource IconPath}" Data="{StaticResource IconPlus}"/>
                            <TextBlock Text="{loc:Tr Common_Add}" Margin="7,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <!-- Ajustes do app: as pecas compartilhadas do DLSS 5 e a calibracao da tela.
                         Tudo o que vale para todos os jogos e nao pertence a nenhum mora aqui —
                         a barra tinha dois botoes para isso e agora tem um. So o icone: a
                         engrenagem e reconhecivel sem rotulo e a barra ja estava cheia. -->
                    <Button Style="{StaticResource ToolButton}" Margin="0,0,7,0" Padding="11,8"
                            ToolTip="{loc:Tr Settings_Title}"
                            AutomationProperties.Name="{loc:Tr Settings_Title}" Click="OnSettingsClick">
                        <Path Style="{StaticResource IconPath}" Data="{StaticResource IconGear}"/>
                    </Button>
                    <Button Style="{StaticResource ToolButton}" AutomationProperties.Name="{loc:Tr Main_Guide}" Click="OnGuideClick">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource IconPath}" Data="{StaticResource IconBook}"/>
                            <TextBlock Text="{loc:Tr Main_Guide}" Margin="7,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
                <Border/>
            </DockPanel>
        </Border>

        <!-- ===== status bar ===== -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource PanelBrush}" Padding="20,10"
                BorderBrush="{StaticResource BorderBrush2}" BorderThickness="0,1,0,0">
            <DockPanel>
                <ProgressBar DockPanel.Dock="Right" Width="140" Height="4" IsIndeterminate="True"
                             VerticalAlignment="Center"
                             Visibility="{Binding Busy, Converter={StaticResource BoolToVis}}"/>
                <TextBlock Text="{Binding StatusText}" FontSize="11.5"
                           Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <!-- Versao nova do proprio launcher. Fica acima de tudo porque e o unico aviso que muda
             o programa que esta desenhando a tela; os outros falam de um jogo. -->
        <Border DockPanel.Dock="Top" CornerRadius="8" Padding="13,10" Margin="10,10,10,0"
                Background="#1B2E3A" BorderBrush="#3A6E8A" BorderThickness="1"
                Visibility="{Binding HasLauncherUpdate, Converter={StaticResource BoolToVis}}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Padding="14,7" VerticalAlignment="Center" Margin="10,0,0,0"
                        Style="{StaticResource AccentButton}" Command="{Binding UpdateLauncherCommand}">
                    <TextBlock Text="{loc:Tr Update_Banner_Button}" FontSize="11.5"/>
                </Button>
                <Path DockPanel.Dock="Left" Data="{StaticResource IconDownload}" Fill="#8FD0F0"
                      Stretch="Uniform" Width="16" Height="16" VerticalAlignment="Center"
                      Margin="0,0,11,0"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding LauncherUpdateTitle}" FontSize="12" FontWeight="SemiBold"
                               Foreground="#A8DCF5"/>
                    <TextBlock Text="{Binding LauncherUpdateDetail}" FontSize="11" TextWrapping="Wrap"
                               Foreground="{StaticResource TextFaintBrush}" Margin="0,2,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Runtimes trocados em algum jogo. Uma troca so aparece quando o jogo abre errado, e
             quem mexeu em varios nao lembra em quais - o launcher sabe, entao avisa. -->
        <Border DockPanel.Dock="Top" CornerRadius="8" Padding="13,10" Margin="10,10,10,0"
                Background="#3A2E1B" BorderBrush="#7A6030" BorderThickness="1"
                Visibility="{Binding HasSwappedGames, Converter={StaticResource BoolToVis}}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Padding="12,7" VerticalAlignment="Center" Margin="10,0,0,0"
                        Command="{Binding RestoreAllDlssCommand}">
                    <TextBlock Text="{loc:Tr Dlss_Sweep_Button}" FontSize="11.5"/>
                </Button>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{loc:Tr Dlss_Sweep_Title}" FontSize="12" FontWeight="SemiBold"
                               Foreground="#F0D0A0"/>
                    <TextBlock Text="{Binding SwappedGames}" FontSize="11" TextWrapping="Wrap"
                               Foreground="{StaticResource TextFaintBrush}" Margin="0,2,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid>
            <ListBox ItemsSource="{Binding GamesView}" SelectedItem="{Binding Selected}"
                     Background="Transparent" BorderThickness="0" Margin="10"
                     ItemTemplate="{StaticResource GameTile}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     VirtualizingPanel.IsVirtualizing="False">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0"/>
                        <!-- Sem isto o card se apresenta ao leitor de tela (e a automacao) como
                             RenoDXLauncher.ViewModels.GameItemVm, o ToString do objeto. -->
                        <Setter Property="AutomationProperties.Name" Value="{Binding Name}"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Bd" CornerRadius="14" BorderThickness="2"
                                            BorderBrush="Transparent" Margin="3">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bd" Property="BorderBrush"
                                                    Value="{StaticResource AccentBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>

            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"
                        Visibility="{Binding ShowEmptyState, Converter={StaticResource BoolToVis}}">
                <Path Data="{StaticResource IconSearch}" Fill="#39404E" Stretch="Uniform"
                      Width="44" Height="44" HorizontalAlignment="Center"/>
                <TextBlock Text="{loc:Tr Main_Empty_Title}" FontSize="15" FontWeight="SemiBold" Margin="0,14,0,0"
                           Foreground="{StaticResource TextDimBrush}" HorizontalAlignment="Center"/>
                <TextBlock Text="{loc:Tr Main_Empty_Hint}"
                           Style="{StaticResource Caption}" Margin="0,5,0,0" HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>
    </DockPanel>

        <!-- ===== modal do jogo: capa + opcoes do RenoDX ===== -->
        <Grid Panel.ZIndex="10" Visibility="{Binding IsDialogOpen, Converter={StaticResource BoolToVis}}">
            <Border Background="#B3070810">
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick" Command="{Binding CloseDialogCommand}"/>
                </Border.InputBindings>
            </Border>

            <Border MaxWidth="1020" MaxHeight="820" Margin="40" CornerRadius="16"
                    Background="{StaticResource PanelBrush}" BorderThickness="1"
                    BorderBrush="{StaticResource BorderStrongBrush}"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="40" ShadowDepth="10" Opacity="0.65" Color="Black"/>
                </Border.Effect>

                <Grid Margin="26,24,26,20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- coluna da capa -->
                    <StackPanel Grid.Row="0" Grid.Column="0" Width="216" Margin="0,0,24,0">
                        <Border Height="324" CornerRadius="12" ClipToBounds="True"
                                Background="#14161B" BorderThickness="1"
                                BorderBrush="{StaticResource BorderBrush2}">
                            <Grid>
                                <TextBlock Text="{Binding Selected.Initials}" FontSize="52" FontWeight="Bold"
                                           Foreground="#3A414E" HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                                <!-- Raio 11 pelo mesmo motivo do card: a moldura nao recorta o filho. -->
                                <Border CornerRadius="11"
                                        Visibility="{Binding Selected.HasCover, Converter={StaticResource BoolToVis}}">
                                    <Border.Background>
                                        <ImageBrush ImageSource="{Binding Selected.CoverPath, Converter={StaticResource CoverImage}}"
                                                    Stretch="UniformToFill"/>
                                    </Border.Background>
                                </Border>
                                <Border VerticalAlignment="Top" HorizontalAlignment="Left" Margin="9"
                                        CornerRadius="7" Width="27" Height="27" Background="#B3080A0E"
                                        ToolTip="{Binding Selected.StoreLabel}">
                                    <Path Data="{Binding Selected.Game.Store, Converter={StaticResource StoreIcon}}"
                                          Fill="#E8EDF5" Stretch="Uniform" Width="14" Height="14"/>
                                </Border>
                            </Grid>
                        </Border>

                        <Button Margin="0,12,0,0" Padding="12,10" Command="{Binding LaunchGameCommand}"
                                AutomationProperties.Name="{loc:Tr Main_Play}">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Path Data="{StaticResource IconPlay}" Fill="{StaticResource TextBrush}"
                                      Stretch="Uniform" Width="14" Height="14" VerticalAlignment="Center"/>
                                <TextBlock Text="{loc:Tr Main_Play}" Margin="8,0,0,0" FontSize="12.5" FontWeight="SemiBold"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <TextBlock Text="{loc:Tr Dialog_InstallDir_Label}" Style="{StaticResource SectionLabel}" Margin="0,16,0,5"/>
                        <TextBlock Text="{Binding Selected.Game.InstallDir}" Style="{StaticResource Caption}"
                                   FontSize="10.5" TextTrimming="CharacterEllipsis" MaxHeight="46"
                                   ToolTip="{Binding Selected.Game.InstallDir}"/>
                    </StackPanel>

                    <!-- coluna das opcoes -->
                    <Grid Grid.Row="0" Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="0,0,0,14">
                            <TextBlock Text="{Binding Selected.Name}" Style="{StaticResource H1}" TextWrapping="Wrap"/>
                            <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                                <TextBlock Text="{Binding Selected.StoreLabel}" FontSize="11.5"
                                           Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Center"/>
                                <Border Width="1" Height="11" Background="{StaticResource BorderStrongBrush}" Margin="10,0"/>
                                <TextBlock Text="{Binding Selected.BadgeText}" FontSize="11.5" FontWeight="SemiBold"
                                           Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"/>

                                <!-- estabilidade do mod, segundo a wiki -->
                                <Border CornerRadius="5" Padding="7,3" Margin="10,0,0,0" Background="#16382B"
                                        VerticalAlignment="Center" ToolTip="{Binding Selected.ModStatusTooltip}"
                                        Visibility="{Binding Selected.ModIsStable, Converter={StaticResource BoolToVis}}">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IconCheck}" Fill="{StaticResource GreenBrush}"
                                              Stretch="Uniform" Width="11" Height="11" VerticalAlignment="Center"/>
                                        <TextBlock Text="{loc:Tr Dialog_Mod_Stable}" FontSize="10.5" FontWeight="SemiBold"
                                                   Foreground="#8FE9C4" Margin="5,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <Border CornerRadius="5" Padding="7,3" Margin="10,0,0,0" Background="#3A2E12"
                                        VerticalAlignment="Center" ToolTip="{Binding Selected.ModStatusTooltip}"
                                        Visibility="{Binding Selected.ModIsUnstable, Converter={StaticResource BoolToVis}}">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IconWarning}" Fill="{StaticResource OrangeBrush}"
                                              Stretch="Uniform" Width="11" Height="11" VerticalAlignment="Center"/>
                                        <TextBlock Text="{loc:Tr Dialog_Mod_Unstable}" FontSize="10.5" FontWeight="SemiBold"
                                                   Foreground="#F5C65E" Margin="5,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- credito do autor do mod: quem mantem, com atalho pro historico -->
                            <Border Margin="0,12,0,0" CornerRadius="10" Padding="12,10"
                                    Background="{StaticResource CardBrush}" BorderThickness="1"
                                    BorderBrush="{StaticResource BorderBrush2}"
                                    Visibility="{Binding Selected.HasMod, Converter={StaticResource BoolToVis}}">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Padding="11,7" VerticalAlignment="Center"
                                            Click="OnHistoryClick" AutomationProperties.Name="{loc:Tr Dialog_History_Name}"
                                            ToolTip="{loc:Tr Dialog_History_Tooltip}">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{StaticResource IconUpdate}" Fill="{StaticResource TextBrush}"
                                                  Stretch="Uniform" Width="13" Height="13" VerticalAlignment="Center"/>
                                            <TextBlock Text="{loc:Tr Common_History}" Margin="7,0,0,0" FontSize="12"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Grid Width="36" Height="36" DockPanel.Dock="Left" VerticalAlignment="Center">
                                        <!-- inicial: fallback quando o autor nao tem foto conhecida -->
                                        <Border CornerRadius="18">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                    <GradientStop Color="#FF8A3D" Offset="0"/>
                                                    <GradientStop Color="#E5622F" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                            <TextBlock Text="{Binding Selected.MaintainerInitial}" FontSize="15"
                                                       FontWeight="Bold" Foreground="#1A1206"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <!-- foto do GitHub -->
                                        <Border CornerRadius="18"
                                                Visibility="{Binding HasMaintainerAvatar, Converter={StaticResource BoolToVis}}">
                                            <Border.Background>
                                                <ImageBrush ImageSource="{Binding MaintainerAvatar, Converter={StaticResource CoverImage}}"
                                                            Stretch="UniformToFill"/>
                                            </Border.Background>
                                        </Border>
                                    </Grid>
                                    <StackPanel Margin="12,0,10,0" VerticalAlignment="Center">
                                        <TextBlock Text="{loc:Tr Dialog_Maintainer_Label}" FontSize="9.5" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextFaintBrush}"/>
                                        <TextBlock Text="{Binding Selected.MaintainerName}" FontSize="13.5"
                                                   FontWeight="SemiBold" Margin="0,2,0,0"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{loc:Tr Dialog_Maintainer_Tooltip}"
                                                   Cursor="Hand">
                                            <TextBlock.InputBindings>
                                                <MouseBinding MouseAction="LeftClick"
                                                              Command="{Binding OpenMaintainerCommand}"/>
                                            </TextBlock.InputBindings>
                                        </TextBlock>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </StackPanel>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,10,0">
<StackPanel>

                            <!-- UPDATE WARNING: the reason the user asked for this -->
                            <Border CornerRadius="10" Padding="13,12" Margin="0,14,0,0" Background="#332612"
                                    BorderBrush="#8A6A1E" BorderThickness="1"
                                    Visibility="{Binding Selected.HasUpdate, Converter={StaticResource BoolToVis}}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IconWarning}" Fill="{StaticResource OrangeBrush}"
                                              Stretch="Uniform" Width="16" Height="16" VerticalAlignment="Center"/>
                                        <TextBlock Text="{loc:Tr Dialog_Update_Title}" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="#F5C65E" Margin="9,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource Caption}" Margin="0,7,0,0" Foreground="#D8C398"
                                               Text="{loc:Tr Dialog_Update_Desc}"/>
                                    <Button Margin="0,11,0,0" Padding="12,8" AutomationProperties.Name="{loc:Tr Dialog_Update_Action_Name}" Command="{Binding InstallCommand}"
                                            HorizontalAlignment="Left">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource AccentButton}">
                                                <Setter Property="Background" Value="#E6A11B"/>
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#F5B534"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{StaticResource IconDownload}" Fill="#231A05" Stretch="Uniform"
                                                  Width="14" Height="14" VerticalAlignment="Center"/>
                                            <TextBlock Text="{loc:Tr Common_Update}" Margin="7,0,0,0" FontSize="12.5"
                                                       FontWeight="SemiBold" Foreground="#231A05"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Border>


                            <!-- correcao de DLSS FG: so aparece quando faz sentido -->
                            <Border CornerRadius="10" Padding="13,11" Margin="0,10,0,0"
                                    Background="#1B2733" BorderBrush="#2F4A5E" BorderThickness="1"
                                    Visibility="{Binding ShowDlssFix, Converter={StaticResource BoolToVis}}">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Padding="12,8" VerticalAlignment="Center"
                                            Command="{Binding DlssFixCommand}"
                                            AutomationProperties.Name="{loc:Tr Dialog_DlssFix_Name}">
                                        <TextBlock Text="{Binding DlssFixButtonText}" FontSize="12"/>
                                    </Button>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,10,0">
                                        <TextBlock Text="{loc:Tr Dialog_DlssFix_Title}" FontSize="12.5"
                                                   FontWeight="SemiBold" Foreground="#A8D4F0"/>
                                        <TextBlock Text="{loc:Tr Dialog_DlssFix_Desc}" FontSize="11"
                                                   Foreground="{StaticResource TextFaintBrush}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>

                            <!-- PRE-REQUISITOS: acima do botao de instalar de proposito. Embaixo,
                                 ficavam fora da area visivel e a pessoa clicava em instalar sem
                                 nunca ver que o jogo exige outra versao do ReShade. -->
                            <StackPanel Margin="0,14,0,0"
                                        Visibility="{Binding Prerequisites.Count, Converter={StaticResource CountToVis}}">
                                <TextBlock Text="{loc:Tr Dialog_Prereq_Label}" Style="{StaticResource SectionLabel}"/>
                                <ItemsControl ItemsSource="{Binding Prerequisites}"
                                              ItemTemplate="{StaticResource NoteCard}"/>
                            </StackPanel>

                            <!-- O banner de INSTALAR saiu daqui.
                                 Instalar e ligar eram dois controles para uma decisao so ("quero
                                 este mod valendo"), em dois lugares diferentes da tela, e o
                                 banner ainda sumia depois de instalado — entao o mesmo gesto
                                 mudava de lugar conforme o estado. O interruptor do cartao
                                 RenoDX HDR faz as duas coisas e fica sempre no mesmo lugar. -->

                            <!-- REPARO: o ReShade da pasta e a build sem suporte a add-ons, entao o
                                 mod nunca vai carregar. Como o banner de instalar some depois de
                                 instalado, sem isto o usuario ficaria sem nenhum caminho de volta. -->
                            <Button Padding="14,13" Margin="0,14,0,0" Command="{Binding RepairReShadeCommand}"
                                    AutomationProperties.Name="{loc:Tr Dialog_Repair_Title}"
                                    Visibility="{Binding NeedsRepair, Converter={StaticResource BoolToVis}}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}"/>
                                </Button.Style>
                                <DockPanel>
                                    <Border DockPanel.Dock="Left" Width="34" Height="34" CornerRadius="10"
                                            Background="#38000000" VerticalAlignment="Center">
                                        <Path Data="{StaticResource IconWarning}" Fill="#241805" Stretch="Uniform"
                                              Width="17" Height="17"/>
                                    </Border>
                                    <StackPanel Margin="13,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{loc:Tr Dialog_Repair_Title}" FontSize="14" FontWeight="SemiBold"
                                                   Foreground="#1A1206"/>
                                        <TextBlock Text="{loc:Tr Dialog_Repair_Desc}"
                                                   FontSize="11" Margin="0,3,0,0" TextWrapping="Wrap"
                                                   Foreground="#5A3A14"/>
                                    </StackPanel>
                                </DockPanel>
                            </Button>

                            <!-- O botao REMOVER saiu daqui.
                                 Desligar o interruptor do RenoDX HDR remove. Manter os dois era
                                 pedir que a pessoa escolhesse entre "desativar" e "remover" sem
                                 nada na tela explicando a diferenca — e a diferenca era so onde
                                 os bytes ficam guardados, que nao e problema de quem usa. -->


                            <Border CornerRadius="9" Padding="12,10" Margin="0,12,0,0" Background="#2A2415"
                                    BorderBrush="#5E4E1E" BorderThickness="1"
                                    Visibility="{Binding DetailStatus.Length, Converter={StaticResource CountToVis}}">
                                <TextBlock Text="{Binding DetailStatus}" TextWrapping="Wrap" FontSize="11.5"
                                           LineHeight="17" Foreground="#F0D9A0"/>
                            </Border>

                            <Border CornerRadius="9" Padding="12,10" Margin="0,10,0,0"
                                    Background="{StaticResource CardBrush}"
                                    BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1"
                                    Visibility="{Binding HasLoadProblem, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{Binding LoadVerdict}" TextWrapping="Wrap" FontSize="11.5"
                                           LineHeight="17" Foreground="{StaticResource TextBrush}"/>
                            </Border>

                            <StackPanel Margin="0,16,0,0"
                                        Visibility="{Binding Advice.Count, Converter={StaticResource CountToVis}}">
                                <TextBlock Text="{loc:Tr Dialog_Advice_Label}" Style="{StaticResource SectionLabel}"/>
                                <ItemsControl ItemsSource="{Binding Advice}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="9" Padding="12,11" Margin="0,0,0,7"
                                                    Background="{Binding Kind, Converter={StaticResource AdviceBg}}">
                                                <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="12"
                                                           FontWeight="SemiBold" LineHeight="17"
                                                           Foreground="{Binding Kind, Converter={StaticResource AdviceFg}}"/>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <!-- RenoDX HDR: o mod do jogo, no mesmo formato do cartao de DLSS 5.
                                 Um interruptor, tres estados por baixo (ausente / instalado e
                                 ligado / instalado e desligado) e um so em cima: esta valendo ou
                                 nao. Os controles finos vivem no overlay do jogo, com Home. -->
                            <Border CornerRadius="10" Padding="13,11" Margin="0,10,0,0"
                                    Background="#1F2A20" BorderBrush="#33543A" BorderThickness="1"
                                    Visibility="{Binding Selected.HasMod, Converter={StaticResource BoolToVis}}">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center"
                                                HorizontalAlignment="Right">
                                        <ToggleButton Style="{StaticResource Switch}"
                                                      IsChecked="{Binding ModReady, Mode=OneWay}"
                                                      Command="{Binding ModCommand}"
                                                      HorizontalAlignment="Right"
                                                      AutomationProperties.Name="{loc:Tr Dialog_Toggle_Name}"/>
                                        <TextBlock Text="{Binding ModStateText}" FontSize="10.5"
                                                   HorizontalAlignment="Right" Margin="0,4,0,0"
                                                   Foreground="{StaticResource TextDimBrush}"/>
                                    </StackPanel>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,10,0">
                                        <TextBlock Text="{loc:Tr Dialog_Mod_Title}" FontSize="12.5"
                                                   FontWeight="SemiBold" Foreground="#8FE0A8"/>
                                        <TextBlock Text="{loc:Tr Dialog_Mod_Desc}" FontSize="11"
                                                   TextWrapping="Wrap"
                                                   Foreground="{StaticResource TextFaintBrush}" Margin="0,2,0,0"/>
                                        <!-- Aplicar o perfil de monitor ficou sem caminho quando a
                                             lista de settings saiu daqui: o valor de nits so era
                                             escrito durante a instalacao, entao mudar o monitor
                                             depois exigia desinstalar e instalar de novo. -->
                                        <Button HorizontalAlignment="Left" Margin="0,8,0,0" Padding="9,5"
                                                Command="{Binding ApplyProfileCommand}"
                                                ToolTip="{loc:Tr Dialog_ApplyProfile_Tooltip}"
                                                Visibility="{Binding Selected.IsInstalled, Converter={StaticResource BoolToVis}}"
                                                AutomationProperties.Name="{loc:Tr Dialog_ApplyProfile_Name}">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Style="{StaticResource IconPath}" Data="{StaticResource IconMonitor}"
                                                      Width="13" Height="13"/>
                                                <TextBlock Text="{loc:Tr Dialog_ApplyProfile_Text}" Margin="6,0,0,0"
                                                           FontSize="11" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </DockPanel>
                            </Border>

                            <!-- Neural Uplift (DLSS-NR): so aparece quando o addon instalado sabe
                                 acionar a feature e o jogo tem DLSS. O requisito de maquina nao
                                 esconde o cartao - vira o aviso NeuralHasBlocker aqui dentro. -->
                            <Border CornerRadius="10" Padding="13,11" Margin="0,10,0,0"
                                    Background="#241B33" BorderBrush="#4A2F5E" BorderThickness="1"
                                    Visibility="{Binding ShowNeural, Converter={StaticResource BoolToVis}}">
                                <StackPanel>
                                    <DockPanel>
                                        <!-- Interruptor unico: liga a cadeia INTEIRA (ReShade, addon,
                                             os dois runtimes, carga antecipada e a chave) pelo mesmo
                                             instalador que o comando `dlss5` usa. -->
                                        <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center"
                                                    HorizontalAlignment="Right">
                                            <ToggleButton Style="{StaticResource Switch}"
                                                          IsChecked="{Binding Dlss5Ready, Mode=OneWay}"
                                                          Command="{Binding Dlss5Command}"
                                                          HorizontalAlignment="Right"
                                                          AutomationProperties.Name="{loc:Tr Dialog_Neural_Name}"/>
                                            <TextBlock Text="{Binding Dlss5StateText}" FontSize="10.5"
                                                       HorizontalAlignment="Right" Margin="0,4,0,0"
                                                       Foreground="{StaticResource TextDimBrush}"/>
                                        </StackPanel>
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,10,0">
                                            <TextBlock Text="{loc:Tr Dialog_Neural_Title}" FontSize="12.5"
                                                       FontWeight="SemiBold" Foreground="#D0A8F0"/>
                                            <TextBlock Text="{loc:Tr Dialog_Neural_Desc}" FontSize="11"
                                                       TextWrapping="Wrap"
                                                       Foreground="{StaticResource TextFaintBrush}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </DockPanel>

                                    <!-- Os elos, um a um. Todo elo quebrado da o MESMO sintoma de
                                         fora — o jogo abre e nada acontece — entao um unico
                                         ligado/desligado nao diz a ninguem o que fazer. -->
                                    <ItemsControl ItemsSource="{Binding Dlss5Chain}" Margin="0,10,0,0">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource ChainChip}"
                                                        Background="#2E2438" BorderBrush="#5A4270">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Ellipse Width="7" Height="7" VerticalAlignment="Center"
                                                                 Margin="0,0,6,0">
                                                            <Ellipse.Style>
                                                                <Style TargetType="Ellipse">
                                                                    <Setter Property="Fill" Value="{StaticResource RedBrush}"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Ok}" Value="True">
                                                                            <Setter Property="Fill" Value="{StaticResource GreenBrush}"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Ellipse.Style>
                                                        </Ellipse>
                                                        <TextBlock Text="{Binding Label}" FontSize="11"
                                                                   Foreground="{StaticResource TextDimBrush}"/>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- Qual tradutor de D3D9 este jogo usa. So aparece em jogo DX9
                                         de 32 bits, que e onde os dois existem.
                                         Os dois disputam o mesmo d3d9.dll, entao e um OU outro —
                                         nunca os dois ao mesmo tempo, e por isso e uma lista e nao
                                         duas chaves. -->
                                    <Border CornerRadius="7" Padding="10,8" Margin="0,10,0,0"
                                            Background="#2A2438" BorderBrush="#5A4270" BorderThickness="1"
                                            Visibility="{Binding MostraTradutorD3d9, Converter={StaticResource BoolToVis}}">
                                        <StackPanel>
                                            <DockPanel>
                                                <!-- Dois botoes, o escolhido preenchido.
                                                     Nao e uma chave liga/desliga: o dgVoodoo2 nao e
                                                     o DXVK desligado, e a outra opcao, do mesmo
                                                     nivel. E uma chave ainda punha o botao a
                                                     direita com o rotulo da esquerda aceso — a
                                                     posicao contradizia a cor. -->
                                                <Border DockPanel.Dock="Right" CornerRadius="7"
                                                        Background="#241E30" BorderBrush="#4A3A63"
                                                        BorderThickness="1" Padding="2"
                                                        VerticalAlignment="Center" Margin="8,0,0,0">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Button Content="DXVK"
                                                                Command="{Binding EscolherTradutorCommand}"
                                                                CommandParameter="dxvk"
                                                                AutomationProperties.Name="DXVK">
                                                            <Button.Style>
                                                                <Style TargetType="Button" BasedOn="{StaticResource SegBtn}">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding UsarDxvk}" Value="True">
                                                                            <Setter Property="Background" Value="#6B4FA0"/>
                                                                            <Setter Property="Foreground" Value="White"/>
                                                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Button.Style>
                                                        </Button>
                                                        <Button Content="dgVoodoo2"
                                                                Command="{Binding EscolherTradutorCommand}"
                                                                CommandParameter="dgvoodoo"
                                                                AutomationProperties.Name="dgVoodoo2">
                                                            <Button.Style>
                                                                <Style TargetType="Button" BasedOn="{StaticResource SegBtn}">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding UsarDgVoodoo}" Value="True">
                                                                            <Setter Property="Background" Value="#6B4FA0"/>
                                                                            <Setter Property="Foreground" Value="White"/>
                                                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Button.Style>
                                                        </Button>
                                                    </StackPanel>
                                                </Border>
                                                <TextBlock Text="{loc:Tr Main_D3d9Translator_Label}" FontSize="11.5"
                                                           VerticalAlignment="Center"
                                                           FontWeight="SemiBold" Foreground="#D0A8F0"/>
                                            </DockPanel>
                                            <TextBlock Text="{loc:Tr Main_D3d9Translator_Hint}" FontSize="10.5"
                                                       TextWrapping="Wrap" Margin="0,6,0,0"
                                                       Foreground="{StaticResource TextFaintBrush}"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Direct3D 10: so o DXVK traduz (a 1.10.3, a ultima com d3d10.dll
                                         proprio — ver DxvkService.D3d10Files), entao nao ha escolha a
                                         fazer — so o aviso de que o jogo passa a apresentar por Vulkan.
                                         Foi o Just Cause 2 que abriu esta rota; ate a 1.69 ela era uma
                                         recusa. -->
                                    <Border CornerRadius="7" Padding="10,8" Margin="0,10,0,0"
                                            Background="#2A2438" BorderBrush="#5A4270" BorderThickness="1"
                                            Visibility="{Binding MostraTradutorD3d10, Converter={StaticResource BoolToVis}}">
                                        <StackPanel>
                                            <TextBlock Text="{loc:Tr Main_D3d10Translator_Label}" FontSize="11.5"
                                                       FontWeight="SemiBold" Foreground="#D0A8F0"/>
                                            <TextBlock Text="{loc:Tr Main_D3d10Translator_Hint}" FontSize="10.5"
                                                       TextWrapping="Wrap" Margin="0,6,0,0"
                                                       Foreground="{StaticResource TextFaintBrush}"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Ponte DX11 em uso: o jogo nao tem D3D12, e o pass so
                                         existe ali por causa dela. Aparece so onde ela esta. -->
                                    <Border CornerRadius="7" Padding="9,7" Margin="0,4,0,0"
                                            Background="#1E2A33" BorderBrush="#356178" BorderThickness="1"
                                            Visibility="{Binding BridgeActive, Converter={StaticResource BoolToVis}}">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="7" Height="7" VerticalAlignment="Top" Margin="0,5,7,0"
                                                     Fill="{StaticResource CyanBrush}"/>
                                            <TextBlock Text="{loc:Tr Dlss5_Bridge_Notice}" FontSize="11"
                                                       TextWrapping="Wrap" Foreground="#A8D4E8"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Feeder em uso: o jogo nao tem DLSS nenhum, e os dados que
                                         o neural consome estao sendo fabricados por um shader.
                                         O aviso calibra a expectativa ANTES da decepcao: aqui o
                                         DLSS 5 rende menos do que num jogo que entrega os proprios
                                         vetores, e nao ha ganho de FPS. Quem nao souber disso vai
                                         concluir que instalou errado. -->
                                    <Border CornerRadius="7" Padding="10,8" Margin="0,4,0,0"
                                            Background="#33291B" BorderBrush="#8A6A30" BorderThickness="1"
                                            Visibility="{Binding MostraAvisoSemDlss, Converter={StaticResource BoolToVis}}">
                                        <DockPanel>
                                            <Path DockPanel.Dock="Left" Data="{StaticResource IconWarning}"
                                                  Fill="#E8B860" Stretch="Uniform" Width="14" Height="14"
                                                  VerticalAlignment="Top" Margin="0,1,9,0"/>
                                            <StackPanel>
                                                <TextBlock Text="{loc:Tr Dlss5_Feeder_Title}" FontSize="11.5"
                                                           FontWeight="SemiBold" Foreground="#F0D0A0"
                                                           TextWrapping="Wrap"/>
                                                <TextBlock Text="{loc:Tr Dlss5_Feeder_Notice}" FontSize="11"
                                                           TextWrapping="Wrap" LineHeight="16" Margin="0,3,0,0"
                                                           Foreground="{StaticResource TextFaintBrush}"/>
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>

                                    <!-- O que MAIS esta na pasta. A cadeia toda verde e o jogo sem
                                         DLSS nenhum e um estado que existe: outro mod ocupando a
                                         vaga do proxy, falsificando a NVAPI, ou duas metades
                                         nossas juntas por historico. Sem isto na tela o usuario
                                         reinstala por cima, que nao resolve. -->
                                    <Border CornerRadius="7" Padding="10,8" Margin="0,9,0,0"
                                            Background="#2B2A1E" BorderBrush="#6E6438" BorderThickness="1"
                                            Visibility="{Binding TemConflitos, Converter={StaticResource BoolToVis}}">
                                        <StackPanel>
                                            <DockPanel>
                                                <Button DockPanel.Dock="Right" Padding="10,6"
                                                        VerticalAlignment="Top" Margin="8,0,0,0"
                                                        Command="{Binding AfastarConflitosCommand}"
                                                        ToolTip="{loc:Tr Conflito_Botao_Explicar}"
                                                        Visibility="{Binding TemBloqueio, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="{loc:Tr Conflito_Botao_Afastar}" FontSize="11.5"/>
                                                </Button>
                                                <StackPanel>
                                                    <TextBlock Text="{loc:Tr Conflito_Titulo}" FontSize="11.5"
                                                               FontWeight="SemiBold" Foreground="#E4D89A"/>
                                                    <TextBlock Text="{Binding ConflitosResumo}" FontSize="11"
                                                               TextWrapping="Wrap" Margin="0,2,0,0"
                                                               Foreground="{StaticResource TextFaintBrush}"/>
                                                </StackPanel>
                                            </DockPanel>
                                            <ItemsControl ItemsSource="{Binding Conflitos}" Margin="0,7,0,0">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Margin="0,4,0,0">
                                                            <DockPanel>
                                                                <Border DockPanel.Dock="Left" CornerRadius="4"
                                                                        Padding="6,2" Margin="0,0,8,0"
                                                                        VerticalAlignment="Center"
                                                                        Background="{Binding Grau, Converter={StaticResource NivelToBrush}}">
                                                                    <TextBlock Text="{Binding Grau, Converter={StaticResource NivelToText}}" FontSize="10"
                                                                               FontWeight="SemiBold" Foreground="#12100A"/>
                                                                </Border>
                                                                <TextBlock Text="{Binding Ferramenta}" FontSize="10.5"
                                                                           DockPanel.Dock="Right" Margin="8,0,0,0"
                                                                           VerticalAlignment="Center"
                                                                           Foreground="{StaticResource TextFaintBrush}"/>
                                                                <TextBlock Text="{Binding Arquivo}" FontSize="11"
                                                                           VerticalAlignment="Center"
                                                                           TextTrimming="CharacterEllipsis"/>
                                                            </DockPanel>
                                                            <TextBlock Text="{Binding Porque}" FontSize="10.5"
                                                                       TextWrapping="Wrap" LineHeight="15"
                                                                       Margin="0,2,0,0"
                                                                       Foreground="{StaticResource TextFaintBrush}"/>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>

                                    <!-- por que esta maquina nao pode ligar -->
                                    <Border CornerRadius="7" Padding="9,7" Margin="0,9,0,0"
                                            Background="#2E2438" BorderBrush="#5A4270" BorderThickness="1"
                                            Visibility="{Binding NeuralHasBlocker, Converter={StaticResource BoolToVis}}">
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Padding="10,6" VerticalAlignment="Center"
                                                    Margin="8,0,0,0"
                                                    Command="{Binding ImportNeuralRuntimeCommand}"
                                                    Visibility="{Binding NeuralNeedsRuntime, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="{loc:Tr Main_Neural_Import}" FontSize="11.5"/>
                                            </Button>
                                            <TextBlock Text="{Binding NeuralBlocker}" FontSize="11"
                                                       TextWrapping="Wrap" VerticalAlignment="Center"
                                                       Foreground="{StaticResource TextFaintBrush}"/>
                                        </DockPanel>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- Multi Frame Generation: quantos quadros o jogo APRESENTA por
                                 quadro que ele realmente renderiza.

                                 Cartao proprio, e nao um ajuste do cartao de DLSS 5: sao coisas
                                 independentes. O MFG multiplica quadros em cima do Frame
                                 Generation que o jogo ja tem, e nao encosta no pass neural — um
                                 jogo pode ter um sem o outro, nos dois sentidos.

                                 O requisito de placa NAO esconde o cartao; vira o aviso roxo la
                                 embaixo. Quem tem uma RTX 30 precisa ler por que nao pode, e um
                                 cartao ausente nao diz isso a ninguem. -->
                            <Border CornerRadius="10" Padding="13,11" Margin="0,10,0,0"
                                    Background="#33202B" BorderBrush="#6E3A55" BorderThickness="1"
                                    Visibility="{Binding ShowMfg, Converter={StaticResource BoolToVis}}">
                                <StackPanel>
                                    <DockPanel>
                                        <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center"
                                                    HorizontalAlignment="Right">
                                            <ToggleButton Style="{StaticResource Switch}"
                                                          IsChecked="{Binding MfgReady, Mode=OneWay}"
                                                          Command="{Binding MfgCommand}"
                                                          HorizontalAlignment="Right"
                                                          AutomationProperties.Name="{loc:Tr Mfg_Title}"/>
                                            <TextBlock Text="{Binding MfgStateText}" FontSize="10.5"
                                                       HorizontalAlignment="Right" Margin="0,4,0,0"
                                                       Foreground="{StaticResource TextDimBrush}"/>
                                        </StackPanel>
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,10,0">
                                            <TextBlock Text="{loc:Tr Mfg_Title}" FontSize="12.5"
                                                       FontWeight="SemiBold" Foreground="#F0A8C8"/>
                                            <TextBlock Text="{loc:Tr Mfg_Title_Desc}" FontSize="11"
                                                       TextWrapping="Wrap"
                                                       Foreground="{StaticResource TextFaintBrush}"
                                                       Margin="0,2,0,0"/>
                                            <!-- O que o patch muda NESTA placa. A mesma acao tem
                                                 resultados diferentes numa RTX 40 e numa RTX 50, e
                                                 um texto unico mentiria para uma das duas. -->
                                            <TextBlock Text="{Binding MfgUnlockText}" FontSize="11"
                                                       TextWrapping="Wrap" Foreground="#D8A8BE"
                                                       Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </DockPanel>

                                    <!-- Os cinco multiplicadores, o escolhido preenchido. Mesmo
                                         formato dos dois botoes de tradutor de D3D9: sao opcoes do
                                         mesmo nivel, nenhuma delas e a ausencia da outra.
                                         Com o recurso ligado, trocar aqui reescreve o arquivo que
                                         o add-on vigia — vale com o jogo aberto. -->
                                    <DockPanel Margin="0,11,0,0">
                                        <Border DockPanel.Dock="Right" CornerRadius="7"
                                                Background="#2A1A24" BorderBrush="#5E3448"
                                                BorderThickness="1" Padding="2"
                                                VerticalAlignment="Center" Margin="8,0,0,0">
                                            <StackPanel Orientation="Horizontal">
                                                <Button Content="2x" Padding="10,5"
                                                        Command="{Binding MfgMultiplierCommand}"
                                                        CommandParameter="2" AutomationProperties.Name="2x">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource SegBtn}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding MfgIs2x}" Value="True">
                                                                    <Setter Property="Background" Value="#A03D6B"/>
                                                                    <Setter Property="Foreground" Value="White"/>
                                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                                <Button Content="3x" Padding="10,5"
                                                        Command="{Binding MfgMultiplierCommand}"
                                                        CommandParameter="3" AutomationProperties.Name="3x">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource SegBtn}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding MfgIs3x}" Value="True">
                                                                    <Setter Property="Background" Value="#A03D6B"/>
                                                                    <Setter Property="Foreground" Value="White"/>
                                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                                <Button Content="4x" Padding="10,5"
                                                        Command="{Binding MfgMultiplierCommand}"
                                                        CommandParameter="4" AutomationProperties.Name="4x">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource SegBtn}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding MfgIs4x}" Value="True">
                                                                    <Setter Property="Background" Value="#A03D6B"/>
                                                                    <Setter Property="Foreground" Value="White"/>
                                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                                <Button Content="5x" Padding="10,5"
                                                        Command="{Binding MfgMultiplierCommand}"
                                                        CommandParameter="5" AutomationProperties.Name="5x">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource SegBtn}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding MfgIs5x}" Value="True">
                                                                    <Setter Property="Background" Value="#A03D6B"/>
                                                                    <Setter Property="Foreground" Value="White"/>
                                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                                <Button Content="6x" Padding="10,5"
                                                        Command="{Binding MfgMultiplierCommand}"
                                                        CommandParameter="6" AutomationProperties.Name="6x">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource SegBtn}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding MfgIs6x}" Value="True">
                                                                    <Setter Property="Background" Value="#A03D6B"/>
                                                                    <Setter Property="Foreground" Value="White"/>
                                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                            </StackPanel>
                                        </Border>
                                        <TextBlock Text="{loc:Tr Mfg_Multiplier_Label}" FontSize="11.5"
                                                   VerticalAlignment="Center" FontWeight="SemiBold"
                                                   Foreground="#F0A8C8"/>
                                    </DockPanel>

                                    <!-- So com a escolha em territorio experimental. Um aviso
                                         permanente vira paisagem e ninguem le. -->
                                    <TextBlock Text="{loc:Tr Mfg_Experimental}" FontSize="10.5"
                                               TextWrapping="Wrap" LineHeight="15" Margin="0,7,0,0"
                                               Foreground="#E8B860"
                                               Visibility="{Binding MfgExperimental, Converter={StaticResource BoolToVis}}"/>

                                    <!-- O que a ULTIMA sessao relatou, escrito pelo proprio add-on
                                         de dentro do jogo. E a unica prova de que o patch pegou:
                                         copiar arquivo com sucesso nao prova nada sobre quadros. -->
                                    <Border CornerRadius="7" Padding="9,7" Margin="0,8,0,0"
                                            Background="#1E2A33" BorderBrush="#356178" BorderThickness="1"
                                            Visibility="{Binding MfgHasLastRun, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="{Binding MfgLastRun}" FontSize="11"
                                                   TextWrapping="Wrap" Foreground="#A8D4E8"/>
                                    </Border>

                                    <!-- por que esta maquina ou este jogo nao pode -->
                                    <Border CornerRadius="7" Padding="9,7" Margin="0,8,0,0"
                                            Background="#2E2438" BorderBrush="#5A4270" BorderThickness="1"
                                            Visibility="{Binding MfgHasBlocker, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="{Binding MfgBlocker}" FontSize="11"
                                                   TextWrapping="Wrap"
                                                   Foreground="{StaticResource TextFaintBrush}"/>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- Runtimes de DLSS: independente do neural. Aparece em qualquer jogo
                                 que carregue um runtime NGX, mostrando a versao atual e para onde
                                 ela subiria. Os originais ficam num .renodx-bak ao lado. -->
                            <Border CornerRadius="10" Padding="13,11" Margin="0,10,0,0"
                                    Background="#1B2733" BorderBrush="#2F4A5E" BorderThickness="1"
                                    Visibility="{Binding ShowDlss, Converter={StaticResource BoolToVis}}">
                                <StackPanel>
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Padding="12,8" VerticalAlignment="Center"
                                                Command="{Binding DlssCommand}"
                                                AutomationProperties.Name="{loc:Tr Dialog_Dlss_Title}">
                                            <TextBlock Text="{Binding DlssButtonText}" FontSize="12"/>
                                        </Button>
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,10,0">
                                            <TextBlock Text="{loc:Tr Dialog_Dlss_Title}" FontSize="12.5"
                                                       FontWeight="SemiBold" Foreground="#8FD0F0"/>
                                            <TextBlock Text="{loc:Tr Dialog_Dlss_Desc}" FontSize="11"
                                                       TextWrapping="Wrap"
                                                       Foreground="{StaticResource TextFaintBrush}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </DockPanel>

                                    <!-- o que o jogo tem hoje, e para onde subiria -->
                                    <TextBlock Text="{Binding DlssSummary}" FontSize="11.5" Margin="0,9,0,0"
                                               TextWrapping="Wrap" FontFamily="Consolas"
                                               Foreground="#B8D8EC"/>

                                    <!-- Estado comprovadamente quebrado. Aparece venha de onde vier
                                         (este launcher, DLSS Swapper, troca manual): so reporta,
                                         porque de fora nao da para saber qual versao o jogo aceita. -->
                                    <Border CornerRadius="7" Padding="9,7" Margin="0,9,0,0"
                                            Background="#3A2424" BorderBrush="#7A4242" BorderThickness="1"
                                            Visibility="{Binding DlssHasIssue, Converter={StaticResource BoolToVis}}">
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Padding="10,6" Margin="8,0,0,0"
                                                    VerticalAlignment="Center"
                                                    Command="{Binding DlssRepairCommand}">
                                                <TextBlock Text="{loc:Tr Main_Dlss_Repair}" FontSize="11.5"/>
                                            </Button>
                                            <TextBlock Text="{Binding DlssHealth}" FontSize="11" TextWrapping="Wrap"
                                                       VerticalAlignment="Center" Foreground="#F0B8B8"/>
                                        </DockPanel>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- Leitura de referencia: as instrucoes, o executavel escolhido e o
                                 veredito do log.

                                 Isto se le uma vez e depois nunca mais, mas estava aberto em toda
                                 visita a um jogo, empurrando para baixo o que se usa sempre — o
                                 botao de ligar. Fica recolhido, e quem precisa abre.

                                 O veredito e a excecao: quando ele traz problema ou build nova, e
                                 exibido inteiro la em cima, fora daqui. Erro atras de um clique e
                                 erro que ninguem le. -->
                            <Expander Margin="0,16,0,0" Padding="0">
                                <Expander.Header>
                                    <TextBlock Text="{loc:Tr Dialog_Details_Label}" FontSize="10.5"
                                               FontWeight="SemiBold" Foreground="{StaticResource TextFaintBrush}"/>
                                </Expander.Header>
                                <StackPanel Margin="0,10,0,0">

                                    <StackPanel Visibility="{Binding Notes.Count, Converter={StaticResource CountToVis}}">
                                        <TextBlock Text="{loc:Tr Dialog_Notes_Label}" Style="{StaticResource SectionLabel}"/>
                                        <ItemsControl ItemsSource="{Binding Notes}"
                                                      ItemTemplate="{StaticResource NoteCard}"/>
                                    </StackPanel>

                                    <!-- Regras que valem para TODOS os jogos do motor: longas e
                                         iguais em centenas de jogos, entao ficam recolhidas para
                                         nao enterrar a instrucao especifica deste jogo. -->
                                    <Expander Margin="0,10,0,0" Padding="0"
                                              Visibility="{Binding EngineNotes.Count, Converter={StaticResource CountToVis}}">
                                        <Expander.Header>
                                            <TextBlock Text="{Binding EngineNotesHeader}" FontSize="10.5"
                                                       FontWeight="SemiBold" Foreground="{StaticResource TextFaintBrush}"/>
                                        </Expander.Header>
                                        <StackPanel Margin="0,8,0,0">
                                            <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,8" TextWrapping="Wrap"
                                                       Text="{loc:Tr Dialog_EngineNotes_Desc}"/>
                                            <ItemsControl ItemsSource="{Binding EngineNotes}"
                                                          ItemTemplate="{StaticResource NoteCard}"/>
                                        </StackPanel>
                                    </Expander>

                                    <TextBlock Text="{loc:Tr Dialog_Exe_Label}" Style="{StaticResource SectionLabel}"
                                               Margin="0,14,0,6"/>
                                    <ComboBox ItemsSource="{Binding ExeCandidates}" SelectedItem="{Binding SelectedExe}"
                                              FontSize="11.5"/>


                                    <Border CornerRadius="9" Padding="12,10" Margin="0,12,0,0"
                                            Background="{StaticResource CardBrush}"
                                            BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1"
                                            Visibility="{Binding LoadVerdictOk, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="{Binding LoadVerdict}" TextWrapping="Wrap" FontSize="11.5"
                                                   LineHeight="17" Foreground="{StaticResource TextDimBrush}"/>
                                    </Border>
                                </StackPanel>
                            </Expander>

                            <!-- Os controles do mod NAO ficam aqui.
                                 Eles vivem no overlay do proprio jogo, onde a pessoa ve o efeito
                                 de cada valor na hora em que mexe. Duplicar a lista aqui pedia que
                                 ela ajustasse HDR olhando para numeros, com o jogo fechado, e
                                 depois abrisse para descobrir o resultado. Home, dentro do jogo,
                                 sempre foi o lugar certo. -->
                        </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <!-- barra de acoes -->
                    <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,18,0,0" Padding="0,16,0,0"
                            BorderBrush="{StaticResource BorderBrush2}" BorderThickness="0,1,0,0">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="{loc:Tr Common_Close}" MinWidth="104" Padding="14,8"
                                    Command="{Binding CloseDialogCommand}" AutomationProperties.Name="{loc:Tr Common_Close}"/>
                            <StackPanel Orientation="Horizontal">
                                <Button Margin="0,0,8,0" Padding="11,8" Command="{Binding OpenFolderCommand}"
                                        ToolTip="{loc:Tr Dialog_OpenFolder}" AutomationProperties.Name="{loc:Tr Dialog_OpenFolder}">
                                    <Path Data="{StaticResource IconFolder}" Fill="{StaticResource TextBrush}"
                                          Stretch="Uniform" Width="15" Height="15"/>
                                </Button>
                                <Button Margin="0,0,8,0" Padding="11,8" Command="{Binding OpenNexusCommand}"
                                        ToolTip="{loc:Tr Dialog_ModPage}" AutomationProperties.Name="{loc:Tr Dialog_ModPage}">
                                    <Path Data="{StaticResource IconGlobe}" Fill="{StaticResource TextBrush}"
                                          Stretch="Uniform" Width="15" Height="15"/>
                                </Button>
                                <!-- ativar/desativar: trocou de lugar com o remover. Renomear o
                                     addon para .disabled serve para comparar HDR ligado x desligado
                                     sem perder a instalacao — util, mas nao e a acao principal. -->
                                <Button Margin="0,0,8,0" Padding="11,8" Command="{Binding ToggleCommand}"
                                        AutomationProperties.Name="{loc:Tr Dialog_Toggle_Name}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                            <Setter Property="ToolTip" Value="{loc:Tr Dialog_Toggle_Enable_Tooltip}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Selected.IsEnabled}" Value="True">
                                                    <Setter Property="ToolTip"
                                                            Value="{loc:Tr Dialog_Toggle_Disable_Tooltip}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <Path Data="{StaticResource IconPower}" Stretch="Uniform" Width="15" Height="15">
                                        <Path.Style>
                                            <Style TargetType="Path">
                                                <Setter Property="Fill" Value="{StaticResource TextDimBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Selected.IsEnabled}" Value="True">
                                                        <Setter Property="Fill" Value="{StaticResource GreenBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Path.Style>
                                    </Path>
                                </Button>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
