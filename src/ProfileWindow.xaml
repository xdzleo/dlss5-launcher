<Window x:Class="RenoDXLauncher.ProfileWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Meu monitor (perfil HDR)" Height="520" Width="520"
        Background="{StaticResource BgBrush}" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <StackPanel Margin="18">
        <TextBlock Text="Perfil HDR do seu monitor" FontSize="17" FontWeight="Bold"/>
        <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource TextDimBrush}" Margin="0,6,0,12"
                   Text="Esses valores são aplicados nos jogos quando você instala um mod (opcional) ou clica em 'Usar meu perfil'. O brilho máximo NÃO é gosto: use o ponto de clipping do app Calibração de HDR do Windows (HGIG)."/>

        <DockPanel>
            <TextBlock DockPanel.Dock="Right" x:Name="PeakText" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
            <TextBlock Text="Brilho máximo do monitor (nits)" FontSize="12"/>
        </DockPanel>
        <Slider x:Name="PeakSlider" Minimum="48" Maximum="4000" TickFrequency="10" IsSnapToTickEnabled="True"
                ValueChanged="OnAnyValueChanged" Margin="0,4,0,2"/>
        <UniformGrid Columns="7" Margin="0,2,0,10">
            <Button Content="400" Click="OnPeakPreset" Margin="1"/>
            <Button Content="600" Click="OnPeakPreset" Margin="1"/>
            <Button Content="800" Click="OnPeakPreset" Margin="1"/>
            <Button Content="1000" Click="OnPeakPreset" Margin="1"/>
            <Button Content="1500" Click="OnPeakPreset" Margin="1"/>
            <Button Content="2000" Click="OnPeakPreset" Margin="1"/>
            <Button Content="4000" Click="OnPeakPreset" Margin="1"/>
        </UniformGrid>

        <DockPanel>
            <TextBlock DockPanel.Dock="Right" x:Name="GameText" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
            <TextBlock Text="Brilho do jogo / paper white (nits)" FontSize="12"/>
        </DockPanel>
        <Slider x:Name="GameSlider" Minimum="48" Maximum="500" TickFrequency="1" IsSnapToTickEnabled="True"
                ValueChanged="OnAnyValueChanged" Margin="0,4,0,2"/>
        <TextBlock Text="Padrão: 203 nits (norma BT.2408). Sala clara: 250–300. Sala escura: 100–200." FontSize="10"
                   Foreground="{StaticResource TextDimBrush}" Margin="0,0,0,10"/>

        <DockPanel>
            <TextBlock DockPanel.Dock="Right" x:Name="UiText" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
            <TextBlock Text="Brilho da interface / HUD (nits)" FontSize="12"/>
        </DockPanel>
        <Slider x:Name="UiSlider" Minimum="48" Maximum="500" TickFrequency="1" IsSnapToTickEnabled="True"
                ValueChanged="OnAnyValueChanged" Margin="0,4,0,2"/>
        <TextBlock Text="Recomendado: igual ao brilho do jogo (203)." FontSize="10"
                   Foreground="{StaticResource TextDimBrush}" Margin="0,0,0,12"/>

        <CheckBox x:Name="ApplyOnInstall" Content="Aplicar este perfil automaticamente ao instalar um mod" FontSize="12"/>

        <UniformGrid Columns="2" Margin="0,18,0,0">
            <Button Content="Salvar" Style="{StaticResource AccentButton}" Margin="0,0,4,0" Click="OnSave"/>
            <Button Content="Cancelar" Margin="4,0,0,0" Click="OnCancel"/>
        </UniformGrid>
    </StackPanel>
</Window>
