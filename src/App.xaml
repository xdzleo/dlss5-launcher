<Application x:Class="RenoDXLauncher.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
>
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Assets/Icons.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- ========== palette ========== -->
            <SolidColorBrush x:Key="BgBrush" Color="#0F1013"/>
            <!-- Os paineis deixaram de ser opacos.
                 O fundo da janela tem dois halos de cor (ver MainWindow); com painel chapado por
                 cima, eles morriam na primeira borda e a tela voltava a ser cinza sobre cinza.
                 Com ~90% de opacidade a cor de baixo atravessa o suficiente para o painel ter
                 tom proprio em cada canto da janela — que e o que a transparencia faz de util
                 aqui, e nao deixar ver o que ha atras. -->
            <!-- Vidro de verdade, e nao cinza com nome de vidro.
                 Estas superficies ja eram translucidas o suficiente para pegar o tom do halo de
                 fundo, e nada mais. Com menos opacidade elas passam a mostrar o que ha ATRAS —
                 a grade de capas por tras do modal, o painel por tras da janela de ajustes — que
                 e o que faz a pilha ter profundidade em vez de ser uma tela por cima da outra.
                 O piso e a legibilidade: abaixo de ~70% o texto comeca a disputar com a capa. -->
            <SolidColorBrush x:Key="PanelBrush" Color="#CC141820"/>
            <SolidColorBrush x:Key="CardBrush" Color="#B31C1F26"/>
            <SolidColorBrush x:Key="CardHoverBrush" Color="#CC2A303C"/>
            <SolidColorBrush x:Key="ElevatedBrush" Color="#B322262F"/>
            <SolidColorBrush x:Key="BorderBrush2" Color="#2C313B"/>
            <SolidColorBrush x:Key="BorderStrongBrush" Color="#3A4150"/>
            <SolidColorBrush x:Key="TextBrush" Color="#F2F4F8"/>
            <SolidColorBrush x:Key="TextDimBrush" Color="#98A0AE"/>
            <SolidColorBrush x:Key="TextFaintBrush" Color="#6B7380"/>
            <SolidColorBrush x:Key="AccentBrush" Color="#FF8A3D"/>
            <SolidColorBrush x:Key="AccentHoverBrush" Color="#FFA061"/>
            <SolidColorBrush x:Key="GreenBrush" Color="#3ECF8E"/>
            <SolidColorBrush x:Key="OrangeBrush" Color="#F0B429"/>
            <SolidColorBrush x:Key="BlueBrush" Color="#4C9AFF"/>
            <SolidColorBrush x:Key="CyanBrush" Color="#4FD1E0"/>
            <SolidColorBrush x:Key="PurpleBrush" Color="#9F86E8"/>
            <SolidColorBrush x:Key="RedBrush" Color="#F2686B"/>
            <SolidColorBrush x:Key="GrayBrush" Color="#4A515D"/>

            <FontFamily x:Key="UiFont">pack://application:,,,/Assets/Fonts/#Inter, Segoe UI Variable Text, Segoe UI</FontFamily>

            <!-- ========== superficies de vidro ==========

                 Cada cartao trazia o proprio par de cores escrito na mao no MainWindow: um
                 #1F2A20 aqui, um #241B33 ali, cada um com raio e padding proprios. O resultado
                 nao era um painel, era uma colecao de retangulos coloridos — e mudar o visual
                 significava caçar trinta literais.

                 O que faz uma superficie parecer vidro nao e transparencia: e a LUZ VINDO DE
                 CIMA. Uma linha clara na borda superior que se apaga na inferior, e um fundo um
                 tom mais claro em cima do que embaixo. Sao os dois gradientes de cada estilo
                 abaixo, e e por isso que a moldura nunca e de cor unica.

                 Sombra so nas superficies grandes (o modal, a barra). Nos cartoes ela seria um
                 DropShadowEffect por cartao dentro de um ScrollViewer — custo de render a cada
                 rolagem, no painel em que ja se reclamou de latencia. A borda iluminada faz o
                 mesmo trabalho de graça. -->
            <CornerRadius x:Key="CardRadius">14</CornerRadius>
            <Thickness x:Key="CardPad">14,13</Thickness>

            <LinearGradientBrush x:Key="GlassRim" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#30FFFFFF" Offset="0"/>
                <GradientStop Color="#14FFFFFF" Offset="0.45"/>
                <GradientStop Color="#0AFFFFFF" Offset="1"/>
            </LinearGradientBrush>

            <Style x:Key="GlassCard" TargetType="Border">
                <Setter Property="CornerRadius" Value="{StaticResource CardRadius}"/>
                <Setter Property="Padding" Value="{StaticResource CardPad}"/>
                <Setter Property="Margin" Value="0,10,0,0"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="BorderBrush" Value="{StaticResource GlassRim}"/>
                <Setter Property="Background">
                    <Setter.Value>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#E61E222B" Offset="0"/>
                            <GradientStop Color="#CC171A21" Offset="1"/>
                        </LinearGradientBrush>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- As pecas de dentro do cartao. Existem para que titulo, texto e selo tenham UM
                 tamanho cada, e nao um por cartao: era assim que a mesma informacao aparecia em
                 12.5 num cartao e em 13 no vizinho, sem que ninguem tivesse decidido isso. -->
            <Style x:Key="CardTitle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource UiFontSemiBold}"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
            </Style>

            <Style x:Key="CardDesc" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11.5"/>
                <Setter Property="LineHeight" Value="17"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
                <Setter Property="Margin" Value="0,3,0,0"/>
                <Setter Property="Foreground" Value="{StaticResource TextDimBrush}"/>
            </Style>

            <!-- Selo do cabecalho: EXPERIMENTAL, OPCIONAL, IMPORTANT. Fundo de branco translucido
                 em vez de cor propria, para pegar o tom do cartao em que ele esta. -->
            <Style x:Key="CardBadge" TargetType="Border">
                <Setter Property="CornerRadius" Value="6"/>
                <Setter Property="Padding" Value="7,3"/>
                <Setter Property="Margin" Value="9,0,0,0"/>
                <Setter Property="Background" Value="#1AFFFFFF"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="BorderBrush" Value="#18FFFFFF"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>

            <Style x:Key="CardBadgeText" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource UiFontSemiBold}"/>
                <Setter Property="FontSize" Value="9.5"/>
                <Setter Property="FontWeight" Value="Bold"/>
            </Style>

            <!-- A pastilha do icone: e ela que da a cada cartao um ponto de entrada para o olho,
                 no mesmo lugar em todos. -->
            <Style x:Key="IconChip" TargetType="Border">
                <Setter Property="Width" Value="30"/>
                <Setter Property="Height" Value="30"/>
                <Setter Property="CornerRadius" Value="9"/>
                <Setter Property="Background" Value="#14FFFFFF"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="BorderBrush" Value="#14FFFFFF"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Margin" Value="0,0,10,0"/>
            </Style>

            <Style x:Key="GlassCardAmber" TargetType="Border" BasedOn="{StaticResource GlassCard}">
                <Setter Property="BorderBrush">
                    <Setter.Value>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#8AF0B429" Offset="0"/>
                            <GradientStop Color="#4DF0B429" Offset="0.5"/>
                            <GradientStop Color="#0AFFFFFF" Offset="1"/>
                        </LinearGradientBrush>
                    </Setter.Value>
                </Setter>
                <Setter Property="Background">
                    <Setter.Value>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#E62E2617" Offset="0"/>
                            <GradientStop Color="#CC221D12" Offset="1"/>
                        </LinearGradientBrush>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="GlassCardBlue" TargetType="Border" BasedOn="{StaticResource GlassCard}">
                <Setter Property="BorderBrush">
                    <Setter.Value>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#8A4C9AFF" Offset="0"/>
                            <GradientStop Color="#4D4C9AFF" Offset="0.5"/>
                            <GradientStop Color="#0AFFFFFF" Offset="1"/>
                        </LinearGradientBrush>
                    </Setter.Value>
                </Setter>
                <Setter Property="Background">
                    <Setter.Value>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#E61C2734" Offset="0"/>
                            <GradientStop Color="#CC161E29" Offset="1"/>
                        </LinearGradientBrush>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="GlassCardGreen" TargetType="Border" BasedOn="{StaticResource GlassCard}">
                <Setter Property="BorderBrush">
                    <Setter.Value>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#8A3ECF8E" Offset="0"/>
                            <GradientStop Color="#4D3ECF8E" Offset="0.5"/>
                            <GradientStop Color="#0AFFFFFF" Offset="1"/>
                        </LinearGradientBrush>
                    </Setter.Value>
                </Setter>
                <Setter Property="Background">
                    <Setter.Value>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#E61D2A22" Offset="0"/>
                            <GradientStop Color="#CC161F19" Offset="1"/>
                        </LinearGradientBrush>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="GlassCardPurple" TargetType="Border" BasedOn="{StaticResource GlassCard}">
                <Setter Property="BorderBrush">
                    <Setter.Value>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#8A9F86E8" Offset="0"/>
                            <GradientStop Color="#4D9F86E8" Offset="0.5"/>
                            <GradientStop Color="#0AFFFFFF" Offset="1"/>
                        </LinearGradientBrush>
                    </Setter.Value>
                </Setter>
                <Setter Property="Background">
                    <Setter.Value>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#E626203A" Offset="0"/>
                            <GradientStop Color="#CC1B172A" Offset="1"/>
                        </LinearGradientBrush>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="GlassCardMagenta" TargetType="Border" BasedOn="{StaticResource GlassCard}">
                <Setter Property="BorderBrush">
                    <Setter.Value>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#8AE86AAE" Offset="0"/>
                            <GradientStop Color="#4DE86AAE" Offset="0.5"/>
                            <GradientStop Color="#0AFFFFFF" Offset="1"/>
                        </LinearGradientBrush>
                    </Setter.Value>
                </Setter>
                <Setter Property="Background">
                    <Setter.Value>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#E62E1F2A" Offset="0"/>
                            <GradientStop Color="#CC22161F" Offset="1"/>
                        </LinearGradientBrush>
                    </Setter.Value>
                </Setter>
            </Style>
            <FontFamily x:Key="UiFontSemiBold">pack://application:,,,/Assets/Fonts/#Inter SemiBold, Segoe UI Semibold, Segoe UI</FontFamily>

            <!-- ========== typography ========== -->
            <Style TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                <Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/>
                <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
            </Style>

            <Style x:Key="H1" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
                <Setter Property="FontSize" Value="21"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            </Style>
            <Style x:Key="H2" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            </Style>
            <Style x:Key="Caption" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
                <Setter Property="FontSize" Value="11.5"/>
                <Setter Property="Foreground" Value="{StaticResource TextDimBrush}"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
            </Style>
            <Style x:Key="SectionLabel" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
                <Setter Property="FontSize" Value="10.5"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{StaticResource TextFaintBrush}"/>
                <Setter Property="Margin" Value="0,0,0,6"/>
            </Style>

            <!-- ========== icon helper ========== -->
            <!-- Glifo de interface: TRACO, nunca preenchimento.
                 Os desenhos vem do Lucide, que sao linhas num grid de 24 — pinta-los com Fill
                 fecha cada linha numa mancha e o icone vira um borrao. Ponta e junta
                 arredondadas pelo mesmo motivo que a fonte da interface e arredondada: e o
                 peso do traco conversando com o peso do texto ao lado, que e a regra que a
                 Apple poe acima de qualquer outra para icone de interface.
                 O traco de 2 e no grid de 24, e o Stretch o reduz junto com o desenho — entao
                 um icone de 13 px e um de 17 px tem a MESMA espessura relativa, como as
                 escalas do SF Symbols. -->
            <Style x:Key="IconPath" TargetType="Path">
                <Setter Property="Stroke" Value="{StaticResource TextBrush}"/>
                <Setter Property="StrokeThickness" Value="2"/>
                <Setter Property="StrokeLineJoin" Value="Round"/>
                <Setter Property="StrokeStartLineCap" Value="Round"/>
                <Setter Property="StrokeEndLineCap" Value="Round"/>
                <Setter Property="Stretch" Value="Uniform"/>
                <Setter Property="Width" Value="16"/>
                <Setter Property="Height" Value="16"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>

            <!-- ========== buttons ========== -->
            <Style TargetType="Button">
                <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
                <Setter Property="Background" Value="{StaticResource CardBrush}"/>
                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush2}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="13,7"/>
                <Setter Property="FontSize" Value="12.5"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="SnapsToDevicePixels" Value="True"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource CardHoverBrush}"/>
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BorderStrongBrush}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#2E3340"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.38"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                <Setter Property="Foreground" Value="#14100A"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="7"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentHoverBrush}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#E5762F"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.38"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>


            <!-- botao primario: gradiente + brilho quente, para a acao principal do modal -->
            <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                <Setter Property="Padding" Value="16,13"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid>
                                <Border x:Name="Glow" CornerRadius="10" Margin="0,3,0,0" Opacity="0.55">
                                    <Border.Background>
                                        <SolidColorBrush Color="#FF8A3D"/>
                                    </Border.Background>
                                    <Border.Effect>
                                        <BlurEffect Radius="16"/>
                                    </Border.Effect>
                                </Border>
                                <!-- RenderTransformOrigin relativo: o encolhimento do clique gira em
                                     torno do centro. CenterX/CenterY no ScaleTransform sao em pixels,
                                     e 0.5 px e o canto: o botao pulava para cima e para a esquerda
                                     ao ser pressionado. -->
                                <Border x:Name="Bd" CornerRadius="10" Padding="{TemplateBinding Padding}"
                                        RenderTransformOrigin="0.5,0.5">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#FFA155" Offset="0"/>
                                            <GradientStop Color="#FF8A3D" Offset="0.5"/>
                                            <GradientStop Color="#EE7328" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <!-- Stretch, nao Center: o conteudo decide se centraliza. Um
                                         ContentPresenter centralizado impede um banner de duas
                                         linhas com icone a esquerda. -->
                                    <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                                </Border>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Glow" Property="Opacity" Value="0.85"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="RenderTransform">
                                        <Setter.Value>
                                            <ScaleTransform ScaleX="0.985" ScaleY="0.96"/>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.35"/>
                                    <Setter TargetName="Glow" Property="Opacity" Value="0"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- card clicavel: mostra o estado do mod em vez de so um rotulo -->
            <Style x:Key="ToggleCard" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                <Setter Property="Padding" Value="12,11"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" CornerRadius="10" Padding="{TemplateBinding Padding}"
                                    Background="{StaticResource CardBrush}" BorderThickness="1"
                                    BorderBrush="{StaticResource BorderBrush2}">
                                <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource CardHoverBrush}"/>
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BorderStrongBrush}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.38"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- toolbar button: icon + label -->
            <!-- Interruptor de verdade, no lugar de um botao que troca de texto.
                 Um botao escrito "Desligar" obriga a pessoa a deduzir o estado a partir da acao;
                 um interruptor MOSTRA o estado e a acao ao mesmo tempo. -->
            <Style x:Key="Switch" TargetType="ToggleButton">
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Focusable" Value="True"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border x:Name="Track" Width="46" Height="26" CornerRadius="13"
                                    Background="{StaticResource GrayBrush}"
                                    BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1">
                                <Ellipse x:Name="Knob" Width="20" Height="20" Fill="White"
                                         HorizontalAlignment="Left" Margin="2,0,0,0"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Track" Property="Background" Value="{StaticResource GreenBrush}"/>
                                    <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/>
                                    <Setter TargetName="Knob" Property="Margin" Value="0,0,2,0"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.45"/>
                                    <Setter Property="Cursor" Value="Arrow"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Um lado de um par de opcoes. O escolhido e PREENCHIDO pelo chamador; este estilo e
                 o estado apagado. Nao ha "ligado" e "desligado" aqui: os dois sao opcoes do mesmo
                 nivel, e por isso nenhum dos dois some quando o outro esta ativo. -->
            <Style x:Key="SegBtn" TargetType="Button">
                <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
                <Setter Property="FontSize" Value="11.5"/>
                <Setter Property="Padding" Value="13,5"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="#9A93AD"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bg" CornerRadius="5" Background="{TemplateBinding Background}"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bg" Property="Opacity" Value="0.82"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.45"/>
                                    <Setter Property="Cursor" Value="Arrow"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Pastilha de um elo da cadeia: verde quando esta no lugar, apagada quando falta.
                 O ponto e poder ler QUAL peca falta sem abrir log nenhum. -->
            <Style x:Key="ChainChip" TargetType="Border">
                <Setter Property="CornerRadius" Value="11"/>
                <Setter Property="Padding" Value="9,4"/>
                <Setter Property="Margin" Value="0,0,6,6"/>
                <Setter Property="BorderThickness" Value="1"/>
            </Style>

            <!-- Botao de simbolo, sem moldura.
                 A barra tinha cinco pilulas contornadas em fila, todas do mesmo peso: uma
                 parede de botoes em que nenhum era mais importante que o outro, e a moldura de
                 cada um competia com o desenho de dentro. A regra da Apple para barra com mais
                 de tres acoes e trocar rotulo por simbolo; e a moldura so aparece quando o
                 ponteiro esta em cima, que e quando ela serve para alguma coisa (dizer o que
                 vai ser clicado).
                 34 px de alvo para um glifo de 17: o alvo de clique nao encolhe junto com o
                 desenho. -->
            <Style x:Key="GlyphButton" TargetType="Button">
                <Setter Property="Width" Value="34"/>
                <Setter Property="Height" Value="34"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{StaticResource TextDimBrush}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" CornerRadius="10" Background="{TemplateBinding Background}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#16FFFFFF"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#24FFFFFF"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.4"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- O glifo dentro do GlyphButton: apagado em repouso, aceso sob o ponteiro. E o
                 mesmo gesto do Finder e da barra do Safari — a fila inteira fica quieta, e so
                 aquele em que voce esta acende. -->
            <Style x:Key="GlyphIcon" TargetType="Path" BasedOn="{StaticResource IconPath}">
                <Setter Property="Width" Value="17"/>
                <Setter Property="Height" Value="17"/>
                <Setter Property="Stroke" Value="{StaticResource TextDimBrush}"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}"
                                 Value="True">
                        <Setter Property="Stroke" Value="{StaticResource TextBrush}"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <!-- Separador entre grupos de acao. Um fio, nao uma barra: ele existe para dizer que
                 "atualizar" e "configurar" sao assuntos diferentes, sem virar mais um traco
                 forte na tela. -->
            <Style x:Key="ToolDivider" TargetType="Border">
                <Setter Property="Width" Value="1"/>
                <Setter Property="Height" Value="18"/>
                <Setter Property="Margin" Value="7,0"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Background" Value="#1FFFFFFF"/>
            </Style>

            <Style x:Key="ToolButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                <Setter Property="Padding" Value="11,7"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush2}"/>
            </Style>

            <!-- ========== text input ========== -->
            <Style TargetType="TextBox">
                <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
                <Setter Property="Background" Value="{StaticResource CardBrush}"/>
                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush2}"/>
                <Setter Property="CaretBrush" Value="{StaticResource AccentBrush}"/>
                <Setter Property="SelectionBrush" Value="{StaticResource AccentBrush}"/>
                <Setter Property="FontSize" Value="12.5"/>
                <Setter Property="Padding" Value="8,6"/>
                <!-- A espessura vem do controle, nao do template: a caixa monoespacada das notas
                     pede BorderThickness=0 e ganhava uma segunda moldura dentro do cartao, porque
                     o template fixava 1 px e ignorava o pedido. -->
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TextBox">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="7">
                                <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- CheckBox e Expander: o WPF traz os dois no tema claro do Windows (caixa branca com
                 borda cinza, seta dentro de um circulo branco) e eram os unicos controles da
                 interface desenhados assim, brilhando no meio do painel escuro. Mesmo vocabulario
                 dos demais: fundo de cartao, borda, laranja quando ativo. -->
            <Style TargetType="CheckBox">
                <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                <Setter Property="FontSize" Value="12.5"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="CheckBox">
                            <StackPanel Orientation="Horizontal" Background="Transparent">
                                <Border x:Name="Box" Width="17" Height="17" CornerRadius="4" VerticalAlignment="Center"
                                        Background="{StaticResource CardBrush}" BorderThickness="1"
                                        BorderBrush="{StaticResource BorderStrongBrush}">
                                    <Path x:Name="Mark" Data="{StaticResource IconCheck}" Stroke="#14100A" StrokeThickness="2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          Stretch="Uniform" Width="11" Height="11" Visibility="Collapsed"/>
                                </Border>
                                <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center"
                                                  RecognizesAccessKey="True"/>
                            </StackPanel>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Box" Property="Background" Value="{StaticResource AccentBrush}"/>
                                    <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                    <Setter TargetName="Mark" Property="Visibility" Value="Visible"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.45"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="Expander">
                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Expander">
                            <DockPanel>
                                <ToggleButton DockPanel.Dock="Top" HorizontalAlignment="Left" Cursor="Hand"
                                              IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                              Content="{TemplateBinding Header}"
                                              ContentTemplate="{TemplateBinding HeaderTemplate}">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border Background="Transparent" Padding="0,3">
                                                <StackPanel Orientation="Horizontal">
                                                    <!-- a seta aponta para a direita fechado, para baixo aberto -->
                                                    <Path x:Name="Chevron" Data="{StaticResource IconChevron}"
                                                          Stroke="{StaticResource TextFaintBrush}" StrokeThickness="2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stretch="Uniform"
                                                          Width="11" Height="11" VerticalAlignment="Center"
                                                          Margin="0,0,7,0" RenderTransformOrigin="0.5,0.5">
                                                        <Path.RenderTransform>
                                                            <RotateTransform Angle="-90"/>
                                                        </Path.RenderTransform>
                                                    </Path>
                                                    <ContentPresenter VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="Chevron" Property="RenderTransform">
                                                        <Setter.Value>
                                                            <RotateTransform Angle="0"/>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Chevron" Property="Stroke" Value="{StaticResource AccentBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                                <ContentPresenter x:Name="ExpandSite" Visibility="Collapsed"
                                                  Margin="{TemplateBinding Padding}"/>
                            </DockPanel>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsExpanded" Value="True">
                                    <Setter TargetName="ExpandSite" Property="Visibility" Value="Visible"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ========== combo ========== -->
            <Style TargetType="ComboBoxItem">
                <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                <Setter Property="FontSize" Value="12.5"/>
                <Setter Property="Padding" Value="10,7"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBoxItem">
                            <Border x:Name="Bd" Background="Transparent" CornerRadius="5" Margin="3,1"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsHighlighted" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource CardHoverBrush}"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#33FF8A3D"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="ComboBox">
                <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                <Setter Property="Background" Value="{StaticResource CardBrush}"/>
                <Setter Property="FontSize" Value="12.5"/>
                <Setter Property="MinHeight" Value="32"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBox">
                            <Grid>
                                <ToggleButton Focusable="False" ClickMode="Press"
                                              IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border x:Name="Bd" Background="{StaticResource CardBrush}"
                                                    BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1"
                                                    CornerRadius="7">
                                                <Path HorizontalAlignment="Right" VerticalAlignment="Center"
                                                      Margin="0,0,9,0" Width="13" Height="13" Stretch="Uniform"
                                                      Data="{StaticResource IconChevron}"
                                                      Stroke="{StaticResource TextDimBrush}" StrokeThickness="2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BorderStrongBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                                <ContentPresenter Margin="11,0,28,0" VerticalAlignment="Center"
                                                  Content="{TemplateBinding SelectionBoxItem}"
                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                  IsHitTestVisible="False">
                                    <ContentPresenter.Resources>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
                                            <Setter Property="FontSize" Value="12.5"/>
                                            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                        </Style>
                                    </ContentPresenter.Resources>
                                </ContentPresenter>
                                <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"
                                       AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                                    <Border Background="{StaticResource ElevatedBrush}"
                                            BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1"
                                            CornerRadius="8" MinWidth="{TemplateBinding ActualWidth}"
                                            MaxHeight="340" Margin="0,4,0,0">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.5" Color="Black"/>
                                        </Border.Effect>
                                        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,3">
                                            <ItemsPresenter/>
                                        </ScrollViewer>
                                    </Border>
                                </Popup>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ========== slider ========== -->
            <!-- ========== a barra de brilho ==========

                 Um estilo proprio, e nao o Slider comum: aqui a barra nao mede "quanto de um
                 ajuste", ela mede LUZ. Uma faixa laranja de tamanho variavel nao diz nada sobre
                 luz; o que diz e a propria cor mudando ao longo do caminho.

                 A rampa e a de um corpo aquecido, que e como o olho ja aprendeu a ler brilho:
                 azul frio no escuro, ciano ao cruzar o limiar de HDR, ouro depois, e branco
                 estourado no fim. Ela e pintada UMA vez ao longo de toda a barra, e o preenchido
                 apenas revela ate onde voce chegou — entao a cor num ponto e sempre a mesma, e
                 arrastar e ver o campo se abrir, nao uma barra crescendo.
 -->
            <LinearGradientBrush x:Key="RampaDeLuz" StartPoint="0,0" EndPoint="1,0">
                <GradientStop Color="#1B3566" Offset="0"/>
                <GradientStop Color="#2B6BA6" Offset="0.13"/>
                <GradientStop Color="#2FA6C4" Offset="0.24"/>
                <GradientStop Color="#5FD2BE" Offset="0.38"/>
                <GradientStop Color="#C8D77E" Offset="0.55"/>
                <GradientStop Color="#F0C266" Offset="0.72"/>
                <GradientStop Color="#FFD9A0" Offset="0.88"/>
                <GradientStop Color="#FFF6E6" Offset="1"/>
            </LinearGradientBrush>

            <Style x:Key="HdrSlider" TargetType="Slider">
                <Setter Property="Height" Value="30"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Slider">
                            <Grid VerticalAlignment="Center">
                                <!-- O caminho inteiro, apagado: da para ver aonde se pode chegar
                                     antes de chegar. Barra que some no escuro esconde metade da
                                     informacao que ela existe para dar. -->
                                <Border Height="10" CornerRadius="5" VerticalAlignment="Center"
                                        Background="{StaticResource RampaDeLuz}" Opacity="0.16"/>
                                <Border Height="10" CornerRadius="5" VerticalAlignment="Center"
                                        BorderThickness="1" BorderBrush="#1AFFFFFF"/>

                                <Track x:Name="PART_Track">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Command="Slider.DecreaseLarge" Focusable="False">
                                            <RepeatButton.Template>
                                                <ControlTemplate TargetType="RepeatButton">
                                                    <!-- O truque do preenchimento: a rampa e
                                                         desenhada com a largura da BARRA INTEIRA e
                                                         recortada pelo botao, que e do tamanho do
                                                         que ja foi percorrido. Pintar a rampa
                                                         dentro do botao faria a cor mudar sozinha
                                                         conforme ele cresce — o azul viraria ouro
                                                         no mesmo ponto da tela. -->
                                                    <Grid ClipToBounds="True">
                                                        <Border HorizontalAlignment="Left" Height="10"
                                                                CornerRadius="5" VerticalAlignment="Center"
                                                                Background="{StaticResource RampaDeLuz}"
                                                                Width="{Binding ActualWidth,
                                                                        RelativeSource={RelativeSource AncestorType=Slider}}"/>
                                                        <!-- Aqui havia um segundo retangulo, mais
                                                             alto e translucido, para simular o
                                                             brilho da barra. Ele era recortado no
                                                             mesmo ponto que o preenchimento, mas
                                                             sobrava acima e abaixo do polegar — e
                                                             o corte reto virava um degrau visivel
                                                             ao lado dele. O preenchimento sozinho
                                                             termina onde o polegar esta, que e
                                                             quem esconde a emenda. -->
                                                    </Grid>
                                                </ControlTemplate>
                                            </RepeatButton.Template>
                                        </RepeatButton>
                                    </Track.DecreaseRepeatButton>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Command="Slider.IncreaseLarge" Focusable="False">
                                            <RepeatButton.Template>
                                                <ControlTemplate TargetType="RepeatButton">
                                                    <Border Background="Transparent"/>
                                                </ControlTemplate>
                                            </RepeatButton.Template>
                                        </RepeatButton>
                                    </Track.IncreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb>
                                            <Thumb.Template>
                                                <ControlTemplate TargetType="Thumb">
                                                    <!-- Branco, e nao da cor da rampa: e o ponto de
                                                         luz que empurra o resto. Se ele tomasse a
                                                         cor do lugar onde esta, sumiria dentro dela
                                                         exatamente onde precisa ser agarrado. -->
                                                    <Grid>
                                                        <Ellipse x:Name="Halo" Width="30" Height="30"
                                                                 Fill="#26FFFFFF" Opacity="0"/>
                                                        <Ellipse Width="18" Height="18" Fill="#14FFFFFF"/>
                                                        <Ellipse Width="14" Height="14" Fill="White"/>
                                                    </Grid>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Halo" Property="Opacity" Value="1"/>
                                                        </Trigger>
                                                        <Trigger Property="IsDragging" Value="True">
                                                            <Setter TargetName="Halo" Property="Opacity" Value="1"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Thumb.Template>
                                        </Thumb>
                                    </Track.Thumb>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="Slider">
                <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                <Setter Property="Height" Value="22"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Slider">
                            <Grid VerticalAlignment="Center">
                                <Border Height="4" CornerRadius="2" Background="#2A2F3A" VerticalAlignment="Center"/>
                                <Track x:Name="PART_Track">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Command="Slider.DecreaseLarge" Focusable="False">
                                            <RepeatButton.Template>
                                                <ControlTemplate TargetType="RepeatButton">
                                                    <Border Height="4" CornerRadius="2"
                                                            Background="{StaticResource AccentBrush}"
                                                            VerticalAlignment="Center"/>
                                                </ControlTemplate>
                                            </RepeatButton.Template>
                                        </RepeatButton>
                                    </Track.DecreaseRepeatButton>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Command="Slider.IncreaseLarge" Focusable="False">
                                            <RepeatButton.Template>
                                                <ControlTemplate TargetType="RepeatButton">
                                                    <Border Background="Transparent"/>
                                                </ControlTemplate>
                                            </RepeatButton.Template>
                                        </RepeatButton>
                                    </Track.IncreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb>
                                            <Thumb.Template>
                                                <ControlTemplate TargetType="Thumb">
                                                    <Grid>
                                                        <Ellipse x:Name="Halo" Width="22" Height="22" Fill="#33FF8A3D"
                                                                 Opacity="0"/>
                                                        <Ellipse Width="14" Height="14" Fill="{StaticResource TextBrush}"/>
                                                    </Grid>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Halo" Property="Opacity" Value="1"/>
                                                        </Trigger>
                                                        <Trigger Property="IsDragging" Value="True">
                                                            <Setter TargetName="Halo" Property="Opacity" Value="1"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Thumb.Template>
                                        </Thumb>
                                    </Track.Thumb>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ========== scrollbar ========== -->
            <Style TargetType="ScrollBar">
                <Setter Property="Width" Value="10"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Grid Background="Transparent">
                                <Track x:Name="PART_Track" IsDirectionReversed="True">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/>
                                    </Track.DecreaseRepeatButton>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/>
                                    </Track.IncreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb>
                                            <Thumb.Template>
                                                <ControlTemplate TargetType="Thumb">
                                                    <Border Background="#3A4150" CornerRadius="5" Margin="2,0"/>
                                                </ControlTemplate>
                                            </Thumb.Template>
                                        </Thumb>
                                    </Track.Thumb>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ========== tooltip ========== -->
            <Style TargetType="ToolTip">
                <Setter Property="Background" Value="{StaticResource ElevatedBrush}"/>
                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}"/>
                <Setter Property="Padding" Value="10,8"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToolTip">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                    CornerRadius="7" Padding="{TemplateBinding Padding}" MaxWidth="380">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.45" Color="Black"/>
                                </Border.Effect>
                                <ContentPresenter/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Setter Property="ContentTemplate">
                    <Setter.Value>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" TextWrapping="Wrap" MaxWidth="350" FontSize="12"
                                       LineHeight="17"/>
                        </DataTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ========== progress ========== -->
            <Style TargetType="ProgressBar">
                <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                <Setter Property="Background" Value="#2A2F3A"/>
                <Setter Property="BorderThickness" Value="0"/>
            </Style>

            <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
