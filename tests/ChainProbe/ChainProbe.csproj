<Project Sdk="Microsoft.NET.Sdk">

  <!-- Executa a MESMA logica que decide Dlss5Ready na interface, contra uma pasta de jogo real,
       e imprime elo por elo. Existe porque tres correcoes desse interruptor foram feitas por
       deducao a partir de arquivos no disco, e nenhuma delas rodou o codigo que a UI roda. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>ChainProbe</AssemblyName>
    <RootNamespace>ChainProbe</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\RenoDXLauncher.csproj" />
  </ItemGroup>

</Project>
